viousAchievementsCount = user.achievements.length\n   116→    user.likedCountries.push(countryName)\n   117→    user.totalPoints += 10\n   118→    checkAchievements(user)\n   119→    saveUser(user)\n   120→    setCurrentUser(user)\n   121→  }\n   122→}\n   123→\n   124→export function visitCountry(countryName: string): void {\n   125→  const user = getCurrentUser()\n   126→  if (!user) return\n   127→\n   128→  if (!user.visitedCountries.includes(countryName)) {\n   129→    const previousAchievementsCount = user.achievements.length\n   130→    user.visitedCountries.push(countryName)\n   131→    user.totalPoints += 50\n   132→    checkAchievements(user)\n   133→    saveUser(user)\n   134→    setCurrentUser(user)\n   135→  }\n   136→}\n   137→\n   138→function checkAchievements(user: FakeUser): void {\n   139→  const achievements = [...user.achievements]\n   140→  \n   141→  if (user.claimedCountries.length >= 1 && !achievements.includes('🌍 First Claim')) {\n   142→    achievements.push('🌍 First Claim')\n   143→    user.totalPoints += 50\n   144→  }\n   145→  \n   146→  if (user.claimedCountries.length >= 10 && !achievements.includes('🏆 Country Collector')) {\n   147→    achievements.push('🏆 Country Collector')\n   148→    user.totalPoints += 200\n   149→  }\n   150→  \n   151→  if (user.claimedCountries.length >= 50 && !achievements.includes('👑 World Dominator')) {\n   152→    achievements.push('👑 World Dominator')\n   153→    user.totalPoints += 1000\n   154→  }\n   155→  \n   156→  if (user.visitedCountries.length >= 5 && !achievements.includes('✈️ Frequent Flyer')) {\n   157→    achievements.push('✈️ Frequent Flyer')\n   158→    user.totalPoints += 150\n   159→  }\n   160→  \n   161→  if (user.likedCountries.length >= 20 && !achievements.includes('❤️ Country Lover')) {\n   162→    achievements.push('❤️ Country Lover')\n   163→    user.totalPoints += 100\n   164→  }\n   165→  \n   166→  if (user.totalPoints >= 1000 && !achievements.includes('⭐ Point Master')) {\n  