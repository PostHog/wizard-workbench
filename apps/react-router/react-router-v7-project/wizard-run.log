          "old_string": "export default function Countries({ loaderData }: Route.ComponentProps) {\n  const { user } = useAuth();\n  const [search, setSearch] = useState<string>(\"\");\n  const [region, setRegion] = useState<string>(\"\");\n\n  // Handler for search input\n  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const newSearch = e.target.value;\n    setSearch(newSearch);\n  };\n\n  // Handler for region filter\n  const handleRegionChange = (e: React.ChangeEvent<HTMLSelectElement>) => {\n    const newRegion = e.target.value;\n    setRegion(newRegion);\n  };",
          "new_string": "export default function Countries({ loaderData }: Route.ComponentProps) {\n  const { user } = useAuth();\n  const posthog = usePostHog();\n  const [search, setSearch] = useState<string>(\"\");\n  const [region, setRegion] = useState<string>(\"\");\n\n  // Handler for search input\n  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const newSearch = e.target.value;\n    setSearch(newSearch);\n  };\n\n  // Handler for search submission (on blur or enter)\n  const handleSearchSubmit = () => {\n    if (search.trim()) {\n      posthog?.capture('countries_searched', { search_term: search.trim() });\n    }\n  };\n\n  // Handler for region filter\n  const handleRegionChange = (e: React.ChangeEvent<HTMLSelectElement>) => {\n    const newRegion = e.target.value;\n    setRegion(newRegion);\n    if (newRegion) {\n      posthog?.capture('countries_filtered_by_region', { region: newRegion });\n    }\n  };\n\n  // Handler for claiming a country\n  const handleClaimCountry = (countryName: string, countryRegion: string) => {\n    claimCountry(countryName);\n    posthog?.capture('country_claimed', { country_name: countryName, region: countryRegion });\n    window.location.reload();\n  };\n\n  // Handler for liking a country\n  const handleLikeCountry = (countryName: string, countryRegion: string) => {\n    likeCountry(countryName);\n    posthog?.capture('country_liked', { country_name: countryName, region: countryRegion });\n    window.location.reload();\n  };\n\n  // Handler for visiting a country\n  const handleVisitCountry = (countryName: string, countryRegion: string) => {\n    visitCountry(countryName);\n    posthog?.capture('country_visited', { country_name: countryName, region: countryRegion });\n    window.location.reload();\n  };"
