  keyPrefix: \"noCurrentPlanModal\",\n    48→  });\n    49→  const [billingPeriod, setBillingPeriod] = useState(\"annual\");\n    50→\n    51→  const navigation = useNavigation();\n    52→  const isSubmitting =\n    53→    navigation.formData?.get(\"intent\") === OPEN_CHECKOUT_SESSION_INTENT;\n    54→  const isSubscribingToLowMonthlyPlan =\n    55→    navigation.formData?.get(\"lookupKey\") ===\n    56→    priceLookupKeysByTierAndInterval.low.monthly;\n    57→  const isSubscribingToMidMonthlyPlan =\n    58→    navigation.formData?.get(\"lookupKey\") ===\n    59→    priceLookupKeysByTierAndInterval.mid.monthly;\n    60→  const isSubscribingToHighMonthlyPlan =\n    61→    navigation.formData?.get(\"lookupKey\") ===\n    62→    priceLookupKeysByTierAndInterval.high.monthly;\n    63→  const isSubscribingToLowAnnualPlan =\n    64→    navigation.formData?.get(\"lookupKey\") ===\n    65→    priceLookupKeysByTierAndInterval.low.annual;\n    66→  const isSubscribingToMidAnnualPlan =\n    67→    navigation.formData?.get(\"lookupKey\") ===\n    68→    priceLookupKeysByTierAndInterval.mid.annual;\n    69→  const isSubscribingToHighAnnualPlan =\n    70→    navigation.formData?.get(\"lookupKey\") ===\n    71→    priceLookupKeysByTierAndInterval.high.annual;\n    72→\n    73→  const getFeatures = (key: string): string[] =>\n    74→    t(`plans.${key}.features`, \"\", { returnObjects: true }) as string[];\n    75→\n    76→  const getButtonProps = (\n    77→    interval: Interval,\n    78→    tier: Tier,\n    79→  ): Partial<ComponentProps<typeof Button>> => {\n    80→    const isSubscribing = {\n    81→      \"annual-high\": isSubscribingToHighAnnualPlan,\n    82→      \"annual-low\": isSubscribingToLowAnnualPlan,\n    83→      \"annual-mid\": isSubscribingToMidAnnualPlan,\n    84→      \"monthly-high\": isSubscribingToHighMonthlyPlan,\n    85→      \"monthly-low\": isSubscribingToLowMonthlyPlan,\n    86→      \"monthly-mid\": isSubscribingToMidMonthlyPlan,\n    87→    }[`${interva