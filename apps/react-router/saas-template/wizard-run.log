r) => planLimits[tier] < currentSeats,\n  );\n\n  return (\n    <Form method=\"post\" replace>\n      {unavailable.length > 0 && (\n        <Alert className=\"mb-4\">\n          <AlertTitle>{tModal(\"disabledPlansAlert.title\")}</AlertTitle>\n\n          <AlertDescription>\n            {unavailable.length === 1\n              ? tModal(\"disabledPlansAlert.descriptionSingular\", {\n                  currentSeats,\n                  planCapacity: planLimits[unavailable[0]!],\n                  planTitle: t(`plans.${unavailable[0]!}.title`),\n                })\n              : tModal(\"disabledPlansAlert.descriptionPlural\", {\n                  currentSeats,\n                  plan1Capacity: planLimits[unavailable[0]!],\n                  plan1Title: t(`plans.${unavailable[0]!}.title`),\n                  plan2Capacity: planLimits[unavailable[1]!],\n                  plan2Title: t(`plans.${unavailable[1]!}.title`),\n                })}\n          </AlertDescription>\n        </Alert>\n      )}\n\n      <fieldset disabled={isSubmitting}>\n        <input\n          name=\"intent\"\n          type=\"hidden\"\n          value={OPEN_CHECKOUT_SESSION_INTENT}\n        />\n\n        <Tabs onValueChange={setBillingPeriod} value={billingPeriod}>\n          <div className=\"mb-4 flex flex-col items-center gap-3 sm:flex-row md:mb-2\">\n            <TabsList>\n              <TabsTrigger value=\"monthly\">{t(\"monthly\")}</TabsTrigger>\n              <TabsTrigger value=\"annual\">{t(\"annual\")}</TabsTrigger>\n            </TabsList>\n\n            {billingPeriod === \"monthly\" && (\n              <p className=\"text-primary text-sm\">{t(\"saveAnnually\")}</p>\n            )}\n          </div>\n\n          <TabsContent value=\"monthly\">\n            <TierContainer>\n              <TierGrid>\n                {/* Low Tier */}\n                <TierCard>\n                  <TierCardHeader>\n                    <TierCardTitle>{t(\"plans.low.title\")}</TierCardTitle>\n\n                    <TierCardPrice>\n                      <Trans\n                        components={{\n                          1: (\n                            <span className=\"font-normal text-muted-foreground text-sm\" />\n                          ),\n                        }}\n                        i18nKey=\"pricing.price\"\n                        ns=\"billing\"\n                        values={{ price: \"$17\" }}\n                      />\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.low.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"monthly\", \"low\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.low.featuresTitle\")}\n                    </FeaturesListTitle>\n                    <FeaturesList>\n                      {getFeatures(\"low\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n\n                {/* Mid Tier */}\n                <TierCard>\n                  <TierCardHeader>\n                    <TierCardTitle>{t(\"plans.mid.title\")}</TierCardTitle>\n\n                    <TierCardPrice>\n                      <Trans\n                        components={{\n                          1: (\n                            <span className=\"font-normal text-muted-foreground text-sm\" />\n                          ),\n                        }}\n                        i18nKey=\"pricing.price\"\n                        ns=\"billing\"\n                        values={{ price: \"$30\" }}\n                      />\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.mid.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"monthly\", \"mid\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.mid.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"mid\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n\n                {/* High Tier */}\n                <TierCard className=\"-mt-1.5 ring-2 ring-primary\">\n                  <TierCardHeader>\n                    <TierCardTitle className=\"text-primary\">\n                      {t(\"plans.high.title\")}\n                      <Badge>{t(\"mostPopular\")}</Badge>\n                    </TierCardTitle>\n\n                    <TierCardPrice>\n                      <Trans\n                        components={{\n                          1: (\n                            <span className=\"font-normal text-muted-foreground text-sm\" />\n                          ),\n                        }}\n                        i18nKey=\"pricing.price\"\n                        ns=\"billing\"\n                        values={{ price: \"$55\" }}\n                      />\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.high.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"monthly\", \"high\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.high.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"high\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n              </TierGrid>\n            </TierContainer>\n          </TabsContent>\n\n          <TabsContent value=\"annual\">\n            <TierContainer>\n              <TierGrid className=\"@6xl/tiers:grid-cols-4\">\n                {/* Low Tier */}\n                <TierCard>\n                  <TierCardHeader>\n                    <TierCardTitle>{t(\"plans.low.title\")}</TierCardTitle>\n\n                    <TierCardPrice>\n                      {\n                        <Trans\n                          components={{\n                            1: (\n                              <span className=\"font-normal text-muted-foreground text-sm\" />\n                            ),\n                          }}\n                          i18nKey=\"pricing.price\"\n                          ns=\"billing\"\n                          values={{ price: \"$15\" }}\n                        />\n                      }\n\n                      <OfferBadge>-10%</OfferBadge>\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.low.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"annual\", \"low\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.low.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"low\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n\n                {/* Mid Tier */}\n                <TierCard>\n                  <TierCardHeader>\n                    <TierCardTitle>{t(\"plans.mid.title\")}</TierCardTitle>\n\n                    <TierCardPrice>\n                      <Trans\n                        components={{\n                          1: (\n                            <span className=\"font-normal text-muted-foreground text-sm\" />\n                          ),\n                        }}\n                        i18nKey=\"pricing.price\"\n                        ns=\"billing\"\n                        values={{ price: \"$25\" }}\n                      />\n\n                      <OfferBadge>-15%</OfferBadge>\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.mid.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"annual\", \"mid\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.mid.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"mid\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n\n                {/* High Tier */}\n                <TierCard className=\"-mt-1.5 ring-2 ring-primary\">\n                  <TierCardHeader>\n                    <TierCardTitle className=\"text-primary\">\n                      {t(\"plans.high.title\")}\n                      <Badge>{t(\"mostPopular\")}</Badge>\n                    </TierCardTitle>\n\n                    <TierCardPrice>\n                      <Trans\n                        components={{\n                          1: (\n                            <span className=\"font-normal text-muted-foreground text-sm\" />\n                          ),\n                        }}\n                        i18nKey=\"pricing.price\"\n                        ns=\"billing\"\n                        values={{ price: \"$45\" }}\n                      />\n\n                      <OfferBadge>-20%</OfferBadge>\n                    </TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.high.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      type=\"submit\"\n                      {...getButtonProps(\"annual\", \"high\")}\n                    />\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.high.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"high\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n\n                {/* Enterprise Tier */}\n                <TierCard className=\"@4xl/tiers:col-start-2 @6xl/tiers:col-start-auto\">\n                  <TierCardHeader>\n                    <TierCardTitle>{t(\"plans.enterprise.title\")}</TierCardTitle>\n\n                    <TierCardPrice>{t(\"custom\")}</TierCardPrice>\n\n                    <TierCardDescription>\n                      {t(\"plans.enterprise.description\")}\n                    </TierCardDescription>\n\n                    <Button\n                      className=\"w-full\"\n                      render={<Link to={href(\"/contact-sales\")} />}\n                    >\n                      {t(\"plans.enterprise.cta\")}\n                    </Button>\n                  </TierCardHeader>\n\n                  <Separator />\n\n                  <TierCardContent>\n                    <FeaturesListTitle>\n                      {t(\"plans.enterprise.featuresTitle\")}\n                    </FeaturesListTitle>\n\n                    <FeaturesList>\n                      {getFeatures(\"enterprise\").map((feature) => (\n                        <FeatureListItem key={feature}>\n                          <IconCheck />\n                          {feature}\n                        </FeatureListItem>\n                      ))}\n                    </FeaturesList>\n                  </TierCardContent>\n                </TierCard>\n              </TierGrid>\n            </TierContainer>\n          </TabsContent>\n        </Tabs>\n      </fieldset>\n    </Form>\n  );\n}\n",
