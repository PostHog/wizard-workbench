        "content": "     1→import { data, Form, href, Link, redirect } from \"react-router\";\n     2→import { z } from \"zod\";\n     3→\n     4→import type { Route } from \"./+types/pastes\";\n     5→import { canCreatePaste } from \"~/features/pastebin/paste-helpers.server\";\n     6→import { organizationMembershipContext } from \"~/features/organizations/organizations-middleware.server\";\n     7→import { prisma } from \"~/utils/database.server\";\n     8→import { validateFormData } from \"~/utils/validate-form-data.server\";\n     9→\n    10→const createPasteSchema = z.object({\n    11→  intent: z.literal(\"create\"),\n    12→  title: z.string().min(1).max(200),\n    13→  content: z.string().min(1).max(100000), // 100KB max\n    14→  language: z.string().optional(),\n    15→  isPublic: z.string().optional().transform((val) => val === \"on\"),\n    16→});\n    17→\n    18→const deletePasteSchema = z.object({\n    19→  intent: z.literal(\"delete\"),\n    20→  pasteId: z.string().min(1),\n    21→});\n    22→\n    23→const pasteActionSchema = z.discriminatedUnion(\"intent\", [\n    24→  createPasteSchema,\n    25→  deletePasteSchema,\n    26→]);\n    27→\n    28→export async function loader({ params, request, context }: Route.LoaderArgs) {\n    29→  const { organizationSlug } = params;\n    30→  \n    31→  // If there's a pasteId in the URL, this route shouldn't handle it\n    32→  const url = new URL(request.url);\n    33→  const pathParts = url.pathname.split('/');\n    34→  const pasteIndex = pathParts.indexOf('pastes');\n    35→  if (pasteIndex !== -1 && pathParts[pasteIndex + 1] && pathParts[pasteIndex + 1] !== '') {\n    36→    // There's a pasteId, let the detail route handle it\n    37→    throw new Response(\"\", { status: 404 });\n    38→  }\n    39→  const { user, organization, headers } = context.get(organizationMembershipContext);\n    40→\n    41→  if (organization.slug !== organizationSlug) {\n    42→    throw redirect(href(\"/organizations/:organizationSlug/pastes\", { organizationSlug: organization.slug }));\n    43→  }\n    44→\n    45→  const pastes = await prisma.paste.findMany({\n    46→    where: {\n    47→      organizationId: organization.id,\n    48→    },\n    49→    include: {\n    50→      createdBy: {\n    51→        select: {\n    52→          id: true,\n    53→          name: true,\n    54→          email: true,\n    55→          imageUrl: true,\n    56→        },\n    57→      },\n    58→    },\n    59→    orderBy: {\n    60→      createdAt: \"desc\",\n    61→    },\n    62→    take: 100, // Limit to 100 most recent\n    63→  });\n    64→\n    65→  const pasteLimits = await canCreatePaste(organization.id);\n    66→\n    67→  // Format dates consistently on the server to avoid hydration mismatches\n    68→  const pastesWithFormattedDates = pastes.map((paste) => ({\n    69→    ...paste,\n    70→    formattedCreatedAt: new Intl.DateTimeFormat(\"en-US\", {\n    71→      month: \"numeric\",\n    72→      day: \"numeric\",\n    73→      year: \"numeric\",\n    74→    }).format(new Date(paste.createdAt)),\n    75→  }));\n    76→\n    77→  return data(\n    78→    {\n    79→      pastes: pastesWithFormattedDates,\n    80→      pasteLimits,\n    81→      breadcrumb: {\n    82→        title: \"Pastes\",\n    83→        to: href(\"/organizations/:organizationSlug/pastes\", {\n    84→          organizationSlug: organization.slug,\n    85→        }),\n    86→      },\n    87→      pageTitle: \"Pastes\",\n    88→    },\n    89→    { headers },\n    90→  );\n    91→}\n    92→\n    93→export async function action({ params, request, context }: Route.ActionArgs) {\n    94→  const { organizationSlug } = params;\n    95→  const { user, organization, headers } = context.get(organizationMembershipContext);\n    96→\n    97→  if (organization.slug !== organizationSlug) {\n    98→    throw redirect(href(\"/organizations/:organizationSlug/pastes\", { organizationSlug: organization.slug }));\n    99→  }\n   100→\n   101→  const result = await validateFormData(request, pasteActionSchema);\n   102→\n   103→  if (!result.success) {\n   104→    return result.response;\n   105→  }\n   106→\n   107→  const { data: body } = result;\n   108→\n   109→  switch (body.intent) {\n   110→    case \"create\": {\n   111→\n   112→      // Check if organization can create more pastes\n   113→      const limits = await canCreatePaste(organization.id);\n   114→      if (!limits.canCreate) {\n   115→        return data(\n   116→          {\n   117→            errors: {\n   118→              _form: [\n   119→                `You've reached your paste limit (${limits.currentCount}/${limits.limit}). Upgrade your plan to create more pastes!`,\n   120→              ],\n   121→            },\n   122→          },\n   123→          { status: 403 },\n   124→        );\n   125→      }\n   126→\n   127→      const paste = await prisma.paste.create({\n   128→        data: {\n   129→          title: body.title,\n   130→          content: body.content,\n   131→          language: body.language || null,\n   132→          isPublic: body.isPublic || false,\n   133→          organizationId: organization.id,\n   134→          createdById: user.id,\n   135→        },\n   136→      });\n   137→\n   138→      return redirect(\n   139→        href(\"/organizations/:organizationSlug/pastes/:pasteId\", {\n   140→          organizationSlug: organization.slug,\n   141→          pasteId: paste.id,\n   142→        }),\n   143→        { headers },\n   144→      );\n   145→    }\n   146→\n   147→    case \"delete\": {\n   148→\n   149→      // Verify paste belongs to organization\n   150→      const paste = await prisma.paste.findFirst({\n   151→        where: {\n   152→          id: body.pasteId,\n   153→          organizationId: organization.id,\n   154→        },\n   155→      });\n   156→\n   157→      if (!paste) {\n   158→        return data({ errors: { _form: [\"Paste not found\"] } }, { status: 404 });\n   159→      }\n   16