 onCancelSubscriptionClick,\n    51→}: CancelOrModifySubscriptionModalContentProps) {\n    52→  const { t } = useTranslation(\"billing\", { keyPrefix: \"pricing\" });\n    53→  const { t: tModal } = useTranslation(\"billing\", {\n    54→    keyPrefix: \"billingPage.pricingModal\",\n    55→  });\n    56→  const [billingPeriod, setBillingPeriod] = useState(\"annual\");\n    57→\n    58→  const isSubmitting =\n    59→    isSwitchingToLow || isSwitchingToMid || isSwitchingToHigh;\n    60→\n    61→  // TODO: change to \"Tier\" - high, low, mid, enterprise\n    62→  const getFeatures = (key: string): string[] =>\n    63→    t(`plans.${key}.features`, \"\", { returnObjects: true }) as string[];\n    64→\n    65→  const getButtonProps = (\n    66→    interval: \"monthly\" | \"annual\",\n    67→    tier: \"low\" | \"mid\" | \"high\",\n    68→  ): Partial<ComponentProps<typeof Button>> => {\n    69→    const isCurrentTier = tier === currentTier;\n    70→    const isUpgrade =\n    71→      (currentTier === \"low\" && (tier === \"mid\" || tier === \"high\")) ||\n    72→      (currentTier === \"mid\" && tier === \"high\");\n    73→\n    74→    // flags for in-flight actions\n    75→    const switchingToThisTier =\n    76→      (tier === \"low\" && isSwitchingToLow) ||\n    77→      (tier === \"mid\" && isSwitchingToMid) ||\n    78→      (tier === \"high\" && isSwitchingToHigh);\n    79→\n    80→    // 1. If this is the current tier but only the billing interval is different\n    81→    if (isCurrentTier) {\n    82→      if (interval !== currentTierInterval) {\n    83→        return interval === \"annual\"\n    84→          ? { children: tModal(\"switchToAnnualButton\") }\n    85→          : {\n    86→              children: tModal(\"switchToMonthlyButton\"),\n    87→              variant: \"outline\",\n    88→            };\n    89→      }\n    90→      return {\n    91→        children: tModal(\"currentPlan\"),\n    92→        disabled: true,\n    93→        variant: \"outline\",\n    94→      };\n    95→    }\n    96→\n    97→    // 2. If we’re already submitting a switch for this tier, show spinner + appropriate label\n    98→    if (switchingToThisTier) {\n    99→      const label = isUpgrade ? (\n   100→        <>\n   101→          <Spinner />\n   102→          {tModal(\"upgrading\")}\n   103→        </>\n   104→      ) : (\n   105→        <>\n   106→          <Spinner />\n   107→          {tModal(\"downgrading\")}\n   108→        </>\n   109→      );\n   110→\n   111→      return { children: label, ...(isUpgrade ? {} : { variant: \"outline\" }) };\n   112→    }\n   113→\n   114→    // 3. Default static buttons for upgrade vs downgrade\n   115→    return isUpgrade\n   116→      ? { children: tModal(\"upgradeButton\"), disabled: isSubmitting }\n   117→      : { children: tModal(\"downgradeButton\"), variant: \"outline\" };\n   118→  };\n   119→\n   120→  return (\n   121→    <>\n   122→      <Form method=\"post\" replace>\n   123→        <fieldset disabled={isSubmitting}>\n   124→          <input\n   125→            name=\"intent\"\n   126→            type=\"hidden\"\n   127→            value={SWITCH_SUBSCRIPTION_INTENT}\n   128→          />\n   129→\n   130→          <Tabs onValueChange={setBillingPeriod} value={billingPeriod}>\n   131→            <div className=\"mb-4 flex flex-col items-center gap-3 sm:flex-row md:mb-2\">\n   132→              <TabsList>\n   133→                <TabsTrigger value=\"monthly\">{t(\"monthly\")}</TabsTrigger>\n   134→                <TabsTrigger value=\"annual\">{t(\"annual\")}</TabsTrigger>\n   135→              </TabsList>\n   136→\n   137→              {billingPeriod === \"monthly\" && (\n   138→                <p className=\"text-primary text-sm\">{t(\"saveAnnually\")}</p>\n   139→              )}\n   140→            </div>\n   141→\n   142→            <TabsContent value=\"monthly\">\n   143→              <TierContainer>\n   144→                <TierGrid>\n   145→                  {/* Low Tier */}\n