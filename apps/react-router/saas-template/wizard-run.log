tInstance(context);\n    40→\n    41→  return data(\n    42→    {\n    43→      pageTitle: getPageTitle(\n    44→        i18n.t.bind(i18n),\n    45→        \"onboarding:userAccount.title\",\n    46→      ),\n    47→      user: auth.user,\n    48→    },\n    49→    { headers: auth.headers },\n    50→  );\n    51→}\n    52→\n    53→export const meta: Route.MetaFunction = ({ loaderData }) => [\n    54→  { title: loaderData?.pageTitle },\n    55→];\n    56→\n    57→export async function action(args: Route.ActionArgs) {\n    58→  return await onboardingUserAccountAction(args);\n    59→}\n    60→\n    61→const ONE_MB = 1_000_000;\n    62→\n    63→export default function UserAccountOnboardingRoute({\n    64→  actionData,\n    65→  loaderData,\n    66→}: Route.ComponentProps) {\n    67→  const { t } = useTranslation(\"onboarding\", { keyPrefix: \"userAccount\" });\n    68→  const { form, fields } = useForm(\n    69→    coerceFormValue(onboardingUserAccountSchema),\n    70→    {\n    71→      lastResult: actionData?.result,\n    72→    },\n    73→  );\n    74→  const navigation = useNavigation();\n    75→  const isSubmitting = navigation.state === \"submitting\";\n    76→\n    77→  return (\n    78→    <Form encType=\"multipart/form-data\" method=\"POST\" {...form.props}>\n    79→      <FieldSet disabled={isSubmitting}>\n    80→        <FieldGroup>\n    81→          <div className=\"flex flex-col gap-1\">\n    82→            <h1 className=\"font-bold text-2xl\">{t(\"heading\")}</h1>\n    83→            <p className=\"text-pretty text-muted-foreground text-sm\">\n    84→              {t(\"subtitle\")}\n    85→            </p>\n    86→          </div>\n    87→\n    88→          <Field data-invalid={fields.name.ariaInvalid}>\n    89→            <FieldLabel htmlFor={fields.name.id}>{t(\"nameLabel\")}</FieldLabel>\n    90→            <FieldDescription id={fields.name.descriptionId}>\n    91→              {t(\"nameDescription\")}\n    92→            </FieldDescription>\n    93→   