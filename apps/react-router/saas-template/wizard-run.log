        "type": "tool_result",
        "content": "     1→import { data, Form, href, Link, redirect } from \"react-router\";\n     2→import { z } from \"zod\";\n     3→\n     4→import type { Route } from \"./+types/pastes\";\n     5→import { canCreatePaste } from \"~/features/pastebin/paste-helpers.server\";\n     6→import { organizationMembershipContext } from \"~/features/organizations/organizations-middleware.server\";\n     7→import { prisma } from \"~/utils/database.server\";\n     8→import { validateFormData } from \"~/utils/validate-form-data.server\";\n     9→\n    10→const createPasteSchema = z.object({\n    11→  intent: z.literal(\"create\"),\n    12→  title: z.string().min(1).max(200),\n    13→  content: z.string().min(1).max(100000), // 100KB max\n    14→  language: z.string().optional(),\n    15→  isPublic: z.string().optional().transform((val) => val === \"on\"),\n    16→});\n    17→\n    18→const deletePasteSchema = z.object({\n    19→  intent: z.literal(\"delete\"),\n    20→  pasteId: z.string().min(1),\n    21→});\n    22→\n    23→const pasteActionSchema = z.discriminatedUnion(\"intent\", [\n    24→  createPasteSchema,\n    25→  deletePasteSchema,\n    26→]);\n    27→\n    28→export async function loader({ params, request, context }: Route.LoaderArgs) {\n    29→  const { organizationSlug } = params;\n    30→  \n    31→  // If there's a pasteId in the URL, this route shouldn't handle it\n    32→  const url = new URL(request.url);\n    33→  const pathParts = url.pathname.split('/');\n    34→  const pasteIndex = pathParts.indexOf('pastes');\n    35→  if (pasteIndex !== -1 && pathParts[pasteIndex + 1] && pathParts[pasteIndex + 1] !== '') {\n    36→    // There's a pasteId, let the detail route handle it\n    37→    throw new Response(\"\", { status: 404 });\n    38→  }\n    39→  const { user, organization, headers } = context.get(organizationMembershipContext);\n    40→\n    41→  if (organization.slug !== organizationSlug) {\n    42→    throw redirect(href(\"/organizations/:organizationSlug/pastes\", { organizationSlug: organization.slug }));\n    43→  }\n    44→\n    45→  const pastes = await prisma.paste.findMany({\n    46→    where: {\n    47→      organizationId: organization.id,\n    48→    },\n    49→    include: {\n    50→      createdBy: {\n    51→        select: {\n    52→          id: true,\n    53→          name: true,\n    54→          email: true,\n    55→          imageUrl: true,\n    56→        },\n    57→      },\n    58→    },\n    59→    orderBy: {\n    60→      createdAt: \"desc\",\n    61→    },\n    62→    take: 100, // Limit to 100 most recent\n    63→  });\n    64→\n    65→  const pasteLimits = await canCreatePaste(organization.id);\n    66→\n    67→  // Format dates consistently on the server to avoid hydration mismatches\n    68→  const pastesWithFormattedDates = pastes.map((paste) => ({\n    69→    ...paste,\n    70→    formattedCreatedAt: new Intl.DateTimeFormat(\"en-US\", {\n    71→      month: \"numeric\",\n    72→      day: \"numeric\",\n    73→      year: \"numeric\",\n    74→    }).format(new Date(paste.createdAt)),\n    75→  }));\n    76→\n    77→  return data(\n    78→    {\n    79→      pastes: pastesWithFormattedDates,\n    80→      pasteLimits,\n    81→      breadcrumb: {\n    82→        title: \"Pastes\",\n    83→        to: href(\"/organizations/:organizationSlug/pastes\", {\n    84→          organizationSlug: organization.slug,\n    85→        }),\n    86→      },\n    87→      pageTitle: \"Pastes\",\n    88→    },\n    89→    { headers },\n    90→  );\n    91→}\n    92→\n    93→export async function action({ params, request, context }: Route.ActionArgs) {\n    94→  const { organizationSlug } = params;\n    95→  const { user, organization, headers } = context.get(organizationMembershipContext);\n    96→\n    97→  if (organization.slug !== organizationSlug) {\n    98→    throw redirect(href(\"/organizations/:organizationSlug/pastes\", { organizationSlug: organization.slug }));\n    99→  }\n   100→\n   101→  const result = await validateFormData(request, pasteActionSchema);\n   102→\n   103→  if (!result.success) {\n   104→    return result.response;\n   105→  }\n   106→\n   107→  const { data: body } = result;\n   108→\n   109→  switch (body.intent) {\n   110→    case \"create\": {\n   111→\n   112→      // Check if organization can create more pastes\n   113→      const limits = await canCreatePaste(organization.id);\n   114→      if (!limits.canCreate) {\n   115→        return data(\n   116→          {\n   117→            errors: {\n   118→              _form: [\n   119→                `You've reached your paste limit (${limits.currentCount}/${limits.limit}). Upgrade your plan to create more pastes!`,\n   120→              ],\n   121→            },\n   122→          },\n   123→          { status: 403 },\n   124→        );\n   125→      }\n   126→\n   127→      const paste = await prisma.paste.create({\n   128→        data: {\n   129→          title: body.title,\n   130→          content: body.content,\n   131→          language: body.language || null,\n   132→          isPublic: body.isPublic || false,\n   133→          organizationId: organization.id,\n   134→          createdById: user.id,\n   135→        },\n   136→      });\n   137→\n   138→      return redirect(\n   139→        href(\"/organizations/:organizationSlug/pastes/:pasteId\", {\n   140→          organizationSlug: organization.slug,\n   141→          pasteId: paste.id,\n   142→        }),\n   143→        { headers },\n   144→      );\n   145→    }\n   146→\n   147→    case \"delete\": {\n   148→\n   149→      // Verify paste belongs to organization\n   150→      const paste = await prisma.paste.findFirst({\n   151→        where: {\n   152→          id: body.pasteId,\n   153→          organizationId: organization.id,\n   154→        },\n   155→      });\n   156→\n   157→      if (!paste) {\n   158→        return data({ errors: { _form: [\"Paste not found\"] } }, { status: 404 });\n   159→      }\n   160→\n   161→      await prisma.paste.delete({\n   162→        where: { id: body.pasteId },\n   163→      });\n   164→\n   165→      return redirect(\n   166→        href(\"/organizations/:organizationSlug/pastes\", {\n   167→          organizationSlug: organization.slug,\n   168→        }),\n   169→        { headers },\n   170→      );\n   171→    }\n   172→  }\n   173→}\n   174→\n   175→export const meta: Route.MetaFunction = ({ loaderData }) => [\n   176→  { title: loaderData?.pageTitle || \"Pastes\" },\n   177→];\n   178→\n   179→export default function PastesRoute({ loaderData, params }: Route.ComponentProps) {\n   180→  const { pastes, pasteLimits } = loaderData;\n   181→\n   182→  return (\n   183→    <div className=\"flex flex-1 flex-col gap-4 px-4 py-4 md:py-6 lg:px-6\">\n   184→      <div className=\"flex items-center justify-between\">\n   185→        <div>\n   186→          <h1 className=\"text-2xl font-bold\">📋 Your Pastes</h1>\n   187→          <p className=\"text-muted-foreground text-sm\">\n   188→            {pasteLimits.currentCount} / {pasteLimits.limit === Infinity ? \"∞\" : pasteLimits.limit} pastes used\n   189→          </p>\n   190→        </div>\n   191→        {pasteLimits.canCreate ? (\n   192→          <a\n   193→            href=\"#create-paste\"\n   194→            className=\"bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium\"\n   195→          >\n   196→            + New Paste\n   197→          </a>\n   198→        ) : (\n   199→          <Link\n   200→            to={href(\"/organizations/:organizationSlug/settings/billing\", {\n   201→              organizationSlug: params.organizationSlug,\n   202→            })}\n   203→            className=\"bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium\"\n   204→          >\n   205→            Upgrade to Create More\n   206→          </Link>\n   207→        )}\n   208→      </div>\n   209→\n   210→      {pasteLimits.currentCount === 0 ? (\n   211→        <div className=\"flex flex-1 items-center justify-center rounded-lg border border-dashed p-12\">\n   212→          <div className=\"text-center\">\n   213→            <p className=\"text-muted-foreground text-lg\">No pastes yet!</p>\n   214→            <p className=\"text-muted-foreground mt-2 text-sm\">\n   215→              Create your first paste to get started.\n   216→            </p>\n   217→          </div>\n   218→        </div>\n   219→      ) : (\n   220→        <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-3\">\n   221→          {pastes.map((paste) => (\n   222→            <Link\n   223→              key={paste.id}\n   224→              to={`/paste/${paste.id}`}\n   225→              className=\"hover:border-primary group rounded-lg border bg-card p-4 transition-colors\"\n   226→            >\n   227→              <div className=\"flex items-start justify-between\">\n   228→                <div className=\"flex-1\">\n   229→                  <h3 className=\"font-semibold group-hover:underline\">{paste.title}</h3>\n   230→                  <p className=\"text-muted-foreground mt-1 line-clamp-2 text-sm\">\n   231→                    {paste.content.substring(0, 100)}\n   232→                    {paste.content.length > 100 ? \"...\" : \"\"}\n   233→                  </p>\n   234→                </div>\n   235→              </div>\n   236→              <div className=\"mt-3 flex items-center gap-4 text-xs text-muted-foreground\">\n   237→                <span>{paste.formattedCreatedAt}</span>\n   238→                <span>{paste.viewCount} views</span>\n   239→                {paste.isPublic && <span className=\"text-primary\">Public</span>}\n   240→              </div>\n   241→            </Link>\n   242→          ))}\n   243→        </div>\n   244→      )}\n   245→\n   246→      {/* Create Paste Form */}\n   247→      <div id=\"create-paste\" className=\"mt-8 rounded-lg border bg-card p-6\">\n   248→        <h2 className=\"mb-4 text-xl font-semibold\">Create New Paste</h2>\n   249→        <Form method=\"post\" className=\"space-y-4\">\n   250→          <input type=\"hidden\" name=\"intent\" value=\"create\" />\n   251→          <div>\n   252→            <label htmlFor=\"title\" className=\"mb-2 block text-sm font-medium\">\n   253→              Title\n   254→            </label>\n   255→            <input\n   256→              type=\"text\"\n   257→              id=\"title\"\n   258→              name=\"title\"\n   259→              required\n   260→              maxLength={200}\n   261→              className=\"border-input bg-background ring-offset-background placeholder:text-muted-foreground focus-visible:ring-ring flex h-10 w-full rounded-md border px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2\"\n   262→              placeholder=\"My Awesome Paste\"\n   263→            />\n   264→          </div>\n   265→          <div>\n   266→            <label htmlFor=\"content\" className=\"mb-2 block text-sm font-medium\">\n   267→              Content\n   268→            </label>\n   269→            <textarea\n   270→              id=\"content\"\n   271→              name=\"content\"\n   272→              required\n   273→              rows={10}\n   274→              className=\"border-input bg-background ring-offset-background placeholder:text-muted-foreground focus-visible:ring-ring flex w-full rounded-md border px-3 py-2 text-sm font-mono focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2\"\n   275→              placeholder=\"Paste your content here...\"\n   276→            />\n   277→          </div>\n   278→          <div className=\"flex items-center gap-4\">\n   279→            <div className=\"flex items-center gap-2\">\n   280→              <input\n   281→                type=\"checkbox\"\n   2