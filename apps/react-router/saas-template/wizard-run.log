iceLookupKeysByTierAndInterval.low.monthly}\n                        {...getButtonProps(\"monthly\", \"low\")}\n                      />\n                    </TierCardHeader>\n\n                    <Separator />\n\n                    <TierCardContent>\n                      <FeaturesListTitle>\n                        {t(\"plans.low.featuresTitle\")}\n                      </FeaturesListTitle>\n                      <FeaturesList>\n                        {getFeatures(\"low\").map((feature) => (\n                          <FeatureListItem key={feature}>\n                            <IconCheck />\n                            {feature}\n                          </FeatureListItem>\n                        ))}\n                      </FeaturesList>\n                    </TierCardContent>\n                  </TierCard>\n\n                  {/* Mid Tier */}\n                  <TierCard>\n                    <TierCardHeader>\n                      <TierCardTitle>{t(\"plans.mid.title\")}</TierCardTitle>\n\n                      <TierCardPrice>\n                        <Trans\n                          components={{\n                            1: (\n                              <span className=\"font-normal text-muted-foreground text-sm\" />\n                            ),\n                          }}\n                          i18nKey=\"pricing.price\"\n                          ns=\"billing\"\n                          values={{ price: \"$30\" }}\n                        />\n                      </TierCardPrice>\n\n                      <TierCardDescription>\n                        {t(\"plans.mid.description\")}\n                      </TierCardDescription>\n\n                      <Button\n                        className=\"w-full\"\n                        name=\"lookupKey\"\n                        type=\"submit\"\n                        value={priceLookupKeysByTierAndInterval.mid.monthly}\n                        {...getButtonProps(\"monthly\", \"mid\")}\n   