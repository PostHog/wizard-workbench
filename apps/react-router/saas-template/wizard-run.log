        "content": "     1→import { report } from \"@conform-to/react/future\";\n     2→import { redirect } from \"react-router\";\n     3→import { z } from \"zod\";\n     4→\n     5→import { anonymousContext } from \"../user-authentication-middleware.server\";\n     6→import { loginWithEmailSchema, loginWithGoogleSchema } from \"./login-schemas\";\n     7→import type { Route } from \".react-router/types/app/routes/_user-authentication+/_anonymous-routes+/+types/login\";\n     8→import { getInstance } from \"~/features/localization/i18next-middleware.server\";\n     9→import { retrieveUserAccountFromDatabaseByEmail } from \"~/features/user-accounts/user-accounts-model.server\";\n    10→import { getErrorMessage } from \"~/utils/get-error-message\";\n    11→import { badRequest } from \"~/utils/http-responses.server\";\n    12→import { validateFormData } from \"~/utils/validate-form-data.server\";\n    13→\n    14→const loginSchema = z.discriminatedUnion(\"intent\", [\n    15→  loginWithEmailSchema,\n    16→  loginWithGoogleSchema,\n    17→]);\n    18→\n    19→export async function loginAction({ request, context }: Route.ActionArgs) {\n    20→  const { supabase, headers } = context.get(anonymousContext);\n    21→  const i18n = getInstance(context);\n    22→  const result = await validateFormData(request, loginSchema);\n    23→\n    24→  if (!result.success) {\n    25→    return result.response;\n    26→  }\n    27→\n    28→  const body = result.data;\n    29→\n    30→  switch (body.intent) {\n    31→    case \"loginWithEmail\": {\n    32→      const userAccount = await retrieveUserAccountFromDatabaseByEmail(\n    33→        body.email,\n    34→      );\n    35→\n    36→      if (!userAccount) {\n    37→        return badRequest({\n    38→          result: report(result.submission, {\n    39→            error: {\n    40→              fieldErrors: {\n    41→                email: [\"userAuthentication:login.form.userDoesntExist\"],\n    42→              },\n    43→              formErrors: [],\n    44→            },\n    45→          }),\n    46→        });\n    47→      }\n    48→\n    49→      const { data, error } = await supabase.auth.signInWithOtp({\n    50→        email: body.email,\n    51→        options: {\n    52→          data: { appName: i18n.t(\"translation:appName\"), intent: body.intent },\n    53→          shouldCreateUser: false,\n    54→        },\n    55→      });\n    56→\n    57→      if (error) {\n    58→        const errorMessage = getErrorMessage(error);\n    59→\n    60→        // Error: For security purposes, you can only request this after 10 seconds.\n    61→        if (errorMessage.includes(\"you can only request this after\")) {\n    62→          return badRequest({\n    63→            result: report(result.submission, {\n    64→              error: {\n    65→                fieldErrors: {\n    66→                  email: [\"userAuthentication:login.form.loginFailed\"],\n    67→                },\n    68→                formErrors: [],\n    69→              },\n    70→            }),\n    71→          });\n    72→        }\n    73→\n    74→        throw new Error(errorMessage);\n    75→      }\n    76→\n    77→      return { ...data, email: body.email, result: undefined };\n    78→    }\n    79→    case \"loginWithGoogle\": {\n    80→      const { data, error } = await supabase.auth.signInWithOAuth({\n    81→        options: { redirectTo: `${process.env.APP_URL}/auth/callback` },\n    82→        provider: \"google\",\n    83→      });\n    84→\n    85→      if (error) {\n    86→        throw error;\n    87→      }\n    88→\n    89→      return redirect(data.url, { headers });\n    90→    }\n    91→  }\n    92→}\n    93→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer