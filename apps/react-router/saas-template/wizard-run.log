        "content": "     1→import type { ReactElement } from \"react\";\n     2→import type { ErrorResponse } from \"react-router\";\n     3→import { isRouteErrorResponse, useParams, useRouteError } from \"react-router\";\n     4→\n     5→import { Alert, AlertDescription, AlertTitle } from \"~/components/ui/alert\";\n     6→import { getErrorMessage } from \"~/utils/get-error-message\";\n     7→\n     8→type StatusHandler = (info: {\n     9→  error: ErrorResponse;\n    10→  params: Record<string, string | undefined>;\n    11→}) => ReactElement | null;\n    12→\n    13→const ErrorMessage = ({\n    14→  title,\n    15→  description,\n    16→}: {\n    17→  title: string;\n    18→  description: string;\n    19→}) => (\n    20→  <div className=\"flex h-full flex-col p-2\">\n    21→    <Alert\n    22→      className=\"flex h-full flex-col items-center justify-center border-destructive/50 bg-destructive/10 dark:border-destructive/80 dark:bg-destructive/5\"\n    23→      variant=\"destructive\"\n    24→    >\n    25→      <AlertTitle className=\"font-semibold\">{title}</AlertTitle>\n    26→      <AlertDescription>{description}</AlertDescription>\n    27→    </Alert>\n    28→  </div>\n    29→);\n    30→\n    31→/**\n    32→ * @see https://github.com/epicweb-dev/epic-stack/blob/main/app/components/error-boundary.tsx\n    33→ */\n    34→export function GeneralErrorBoundary({\n    35→  defaultStatusHandler = ({ error }) => (\n    36→    <ErrorMessage\n    37→      description={error.data as string}\n    38→      title={`${error.status} ${error.statusText}`}\n    39→    />\n    40→  ),\n    41→  statusHandlers = {\n    42→    404: ({ error }) => {\n    43→      throw error;\n    44→    },\n    45→  },\n    46→  unexpectedErrorHandler = (error) => (\n    47→    <ErrorMessage description={getErrorMessage(error)} title=\"Oh snap!\" />\n    48→  ),\n    49→}: {\n    50→  defaultStatusHandler?: StatusHandler;\n    51→  statusHandlers?: Record<number, StatusHandler>;\n    52→  unexpectedErrorHandler?: (error: unknown) => ReactElement | null;\n    53→}) {\n    54→  const error = useRouteError();\n    55→  const params = useParams();\n    56→\n    57→  if (typeof document !== \"undefined\") {\n    58→    console.error(\"client error in general error boundary\", error);\n    59→  }\n    60→\n    61→  return (\n    62→    <div className=\"h-full\">\n    63→      {isRouteErrorResponse(error)\n    64→        ? (statusHandlers?.[error.status] ?? defaultStatusHandler)({\n    65→            error,\n    66→            params,\n    67→          })\n    68→        : unexpectedErrorHandler(error)}\n    69→    </div>\n    70→  );\n    71→}\n    72→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
