        "tool_use_id": "toolu_014vSUoQ6Eu2bfaCEKCHiZNy",
        "type": "tool_result",
        "content": "     1→'use client';\n     2→\n     3→import { useState, useEffect } from 'react';\n     4→import Link from 'next/link';\n     5→import { Todo } from '@/lib/data';\n     6→import { TodoForm } from './todo-form';\n     7→import { TodoItem } from './todo-item';\n     8→import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n     9→\n    10→export function TodoList() {\n    11→  const [todos, setTodos] = useState<Todo[]>([]);\n    12→  const [loading, setLoading] = useState(true);\n    13→\n    14→  useEffect(() => {\n    15→    fetchTodos();\n    16→  }, []);\n    17→\n    18→  const fetchTodos = async () => {\n    19→    try {\n    20→      const response = await fetch('/api/todos');\n    21→      if (response.ok) {\n    22→        const data = await response.json();\n    23→        setTodos(data);\n    24→      }\n    25→    } catch (error) {\n    26→      console.error('Failed to fetch todos:', error);\n    27→    } finally {\n    28→      setLoading(false);\n    29→    }\n    30→  };\n    31→\n    32→  const handleAddTodo = async (title: string, description: string) => {\n    33→    try {\n    34→      const response = await fetch('/api/todos', {\n    35→        method: 'POST',\n    36→        headers: {\n    37→          'Content-Type': 'application/json',\n    38→        },\n    39→        body: JSON.stringify({ title, description }),\n    40→      });\n    41→\n    42→      if (response.ok) {\n    43→        const newTodo = await response.json();\n    44→        setTodos([...todos, newTodo]);\n    45→      }\n    46→    } catch (error) {\n    47→      console.error('Failed to add todo:', error);\n    48→    }\n    49→  };\n    50→\n    51→  const handleToggleTodo = async (id: number, completed: boolean) => {\n    52→    try {\n    53→      const response = await fetch(`/api/todos/${id}`, {\n    54→        method: 'PATCH',\n    55→        headers: {\n    56→          'Content-Type': 'application/json',\n    57→        },\n    58→        body: JSON.stringify({ completed }),\n    59→      });\n    60→\n    61→      if (response.ok) {\n    62→        const updatedTodo = await response.json();\n    63→        setTodos(todos.map((todo) => (todo.id === id ? updatedTodo : todo)));\n    64→      }\n    65→    } catch (error) {\n    66→      console.error('Failed to update todo:', error);\n    67→    }\n    68→  };\n    69→\n    70→  const handleDeleteTodo = async (id: number) => {\n    71→    try {\n    72→      const response = await fetch(`/api/todos/${id}`, {\n    73→        method: 'DELETE',\n    74→      });\n    75→\n    76→      if (response.ok) {\n    77→        setTodos(todos.filter((todo) => todo.id !== id));\n    78→      }\n    79→    } catch (error) {\n    80→      console.error('Failed to delete todo:', error);\n    81→    }\n    82→  };\n    83→\n    84→  if (loading) {\n    85→    return (\n    86→      <div className=\"flex items-center justify-center min-h-screen\">\n    87→        <p className=\"text-muted-foreground\">Loading...</p>\n    88→      </div>\n    89→    );\n    90→  }\n    91→\n    92→  const activeTodos = todos.filter((todo) => !todo.completed);\n    93→  const completedTodos = todos.filter((todo) => todo.completed);\n    94→\n    95→  return (\n    96→    <div className=\"max-w-3xl mx-auto p-6 space-y-8\">\n    97→      <div>\n    98→        <div className=\"flex items-center justify-between mb-2\">\n    99→          <h1 className=\"text-4xl font-bold\">Todo App</h1>\n   100→          <Link\n   101→            href=\"/about\"\n   102→            className=\"text-sm text-primary hover:underline\"\n   103→          >\n   104→            About\n   105→          </Link>\n   106→        </div>\n   107→        <p className=\"text-muted-foreground\">\n   108→          Manage your tasks with Next.js 15 server-side API routes\n   109→        </p>\n   110→      </div>\n   111→\n   112→      <Card>\n   113→        <CardHeader>\n   114→          <