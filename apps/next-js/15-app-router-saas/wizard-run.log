        "content": "     1→'use client';\n     2→\n     3→import { Button } from '@/components/ui/button';\n     4→import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';\n     5→import {\n     6→  Card,\n     7→  CardContent,\n     8→  CardHeader,\n     9→  CardTitle,\n    10→  CardFooter\n    11→} from '@/components/ui/card';\n    12→import { customerPortalAction } from '@/lib/payments/actions';\n    13→import { useActionState } from 'react';\n    14→import { TeamDataWithMembers, User } from '@/lib/db/schema';\n    15→import { removeTeamMember, inviteTeamMember } from '@/app/(login)/actions';\n    16→import useSWR from 'swr';\n    17→import { Suspense } from 'react';\n    18→import { Input } from '@/components/ui/input';\n    19→import { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';\n    20→import { Label } from '@/components/ui/label';\n    21→import { Loader2, PlusCircle } from 'lucide-react';\n    22→\n    23→type ActionState = {\n    24→  error?: string;\n    25→  success?: string;\n    26→};\n    27→\n    28→const fetcher = (url: string) => fetch(url).then((res) => res.json());\n    29→\n    30→function SubscriptionSkeleton() {\n    31→  return (\n    32→    <Card className=\"mb-8 h-[140px]\">\n    33→      <CardHeader>\n    34→        <CardTitle>Team Subscription</CardTitle>\n    35→      </CardHeader>\n    36→    </Card>\n    37→  );\n    38→}\n    39→\n    40→function ManageSubscription() {\n    41→  const { data: teamData } = useSWR<TeamDataWithMembers>('/api/team', fetcher);\n    42→\n    43→  return (\n    44→    <Card className=\"mb-8\">\n    45→      <CardHeader>\n    46→        <CardTitle>Team Subscription</CardTitle>\n    47→      </CardHeader>\n    48→      <CardContent>\n    49→        <div className=\"space-y-4\">\n    50→          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n    51→            <div className=\"mb-4 sm:mb-0\">\n    52→              <p className=\"font-medium\">\n    53→                Current Plan: {teamData?.planName || 'Free'}\n    54→              </p>\n    55→              <p className=\"text-sm text-muted-foreground\">\n    56→                {teamData?.subscriptionStatus === 'active'\n    57→                  ? 'Billed monthly'\n    58→                  : teamData?.subscriptionStatus === 'trialing'\n    59→                  ? 'Trial period'\n    60→                  : 'No active subscription'}\n    61→              </p>\n    62→            </div>\n    63→            <form action={customerPortalAction}>\n    64→              <Button type=\"submit\" variant=\"outline\">\n    65→                Manage Subscription\n    66→              </Button>\n    67→            </form>\n    68→          </div>\n    69→        </div>\n    70→      </CardContent>\n    71→    </Card>\n    72→  );\n    73→}\n    74→\n    75→function TeamMembersSkeleton() {\n    76→  return (\n    77→    <Card className=\"mb-8 h-[140px]\">\n    78→      <CardHeader>\n    79→        <CardTitle>Team Members</CardTitle>\n    80→      </CardHeader>\n    81→      <CardContent>\n    82→        <div className=\"animate-pulse space-y-4 mt-1\">\n    83→          <div className=\"flex items-center space-x-4\">\n    84→            <div className=\"size-8 rounded-full bg-gray-200\"></div>\n    85→            <div className=\"space-y-2\">\n    86→              <div className=\"h-4 w-32 bg-gray-200 rounded\"></div>\n    87→              <div className=\"h-3 w-14 bg-gray-200 rounded\"></div>\n    88→            </div>\n    89→          </div>\n    90→        </div>\n    91→      </CardContent>\n    92→    </Card>\n    93→  );\n    94→}\n    95→\n    96→function TeamMembers() {\n    97→  const { data: teamData } = useSWR<TeamDataWithMembers>('/api/team', fetcher);\n    98→  const [removeState, removeAction, isRemovePending] = useActionState<\n    99→    ActionState,\n   100→    FormData\n   101→  >(removeTeamMember, {});\n   102→\n   103→  const getUserDisplayName = (user: Pick<User, 'id' | 'name' | 'email'>) => {\n   104→    return user.name || user.email || 'Unknown User';\n   105→  };\n   106→\n   107→  if (!teamData?.teamMembers?.length) {\n   108→    return (\n   109→      <Card className=\"mb-8\">\n   110→        <CardHeader>\n   111→          <CardTitle>Team Members</CardTitle>\n   112→        </CardHeader>\n   113→        <CardContent>\n   114→          <p className=\"text-muted-foreground\">No team members yet.</p>\n   115→        </CardContent>\n   116→      </Card>\n   117→    );\n   118→  }\n   119→\n   120→  return (\n   121→    <Card className=\"mb-8\">\n   122→      <CardHeader>\n   123→        <CardTitle>Team Members</CardTitle>\n   124→      </CardHeader>\n   125→      <CardContent>\n   126→        <ul className=\"space-y-4\">\n   127→          {teamData.teamMembers.map((member, index) => (\n   128→            <li key={member.id} className=\"flex items-center justify-between\">\n   129→              <div className=\"flex items-center space-x-4\">\n   130→                <Avatar>\n   131→                  {/* \n   132→                    This app doesn't save profile images, but here\n   133→                    is how you'd show them:\n   134→\n   135→                    <AvatarImage\n   136→                      src={member.user.image || ''}\n   137→                      alt={getUserDisplayName(member.user)}\n   138→                    />\n   139→                  */}\n   140→                  <AvatarFallback>\n   141→                    {getUserDisplayName(member.user)\n   142→                      .split(' ')\n   143→                      .map((n) => n[0])\n   144→                      .join('')}\n   145→                  </AvatarFallback>\n   146→                </Avatar>\n   147→                <div>\n   148→                  <p className=\"font-medium\">\n   149→                    {getUserDisplayName(member.user)}\n   150→                  </p>\n   151→                  <p className=\"text-sm text-muted-foreground capitalize\">\n   152→                    {member.role}\n   153→                  </p>\n   154→                </div>\n   155→              </div>\n   156→              {index > 1 ? (\n   157→                <form action={removeAction}>\n   158→                  <input type=\"hidden\" name=\"memberId\" value={member.id} />\n   159→                  <Button\n   160→                    type=\"submit\"\n   161→                    variant=\"outline\"\n   162→                    size=\"sm\"\n   163→                    disabled={isRemovePending}\n   164→                  >\n   165→                    {isRemovePending ? 'Removing...' : 'Remove'}\n   166→                  </Button>\n   167→                </form>\n   168→              ) : null}\n   169→            </li>\n   170→          ))}\n   171→        </ul>\n   172→        {removeState?.error && (\n   173→          <p className=\"text-red-500 mt-4\">{removeState.error}</p>\n   174→        )}\n   175→      </CardContent>\n   176→    </Card>\n   177→  );\n   178→}\n   179→\n   180→function InviteTeamMemberSkeleton() {\n   181→  return (\n   182→    <Card className=\"h-[260px]\">\n   183→      <CardHeader>\n   184→        <CardTitle>Invite Team Member</CardTitle>\n   185→      </CardHeader>\n   186→    </Card>\n   187→  );\n   188→}\n   189→\n   190→function InviteTeamMember() {\n   191→  const { data: user } = useSWR<User>('/api/user', fetcher);\n   192→  const isOwner = user?.role === 'owner';\n   193→  const [inviteState, inviteAction, isInvitePending] = useActionState<\n   194→    ActionState,\n   195→    FormData\n   196→  >(inviteTeamMember, {});\n   197→\n   198→  return (\n   199→    <Card>\n   200→      <CardHeader>\n   201→        <CardTitle>Invite Team Member</CardTitle>\n   202→      </CardHeader>\n   203→      <CardContent>\n   204→        <form action={inviteAction} className=\"space-y-4\">\n   205→          <div>\n   206→            <Label htmlFor=\"email\" className=\"mb-2\">\n   207→              Email\n   208→            </Label>\n   209→            <Input\n   210→              id=\"email\"\n   211→              name=\"email\"\n   212→              type=\"email\"\n   213→              placeholder=\"Enter email\"\n   214→              required\n   215→              disabled={!isOwner}\n   216→            />\n   217→          </div>\n   218→          <div>\n   219→            <Label>Role</Label>\n   220→            <RadioGroup\n   221→              defaultValue=\"member\"\n   222→              name=\"role\"\n   223→              className=\"flex space-x-4\"\n   224→              disabled={!isOwner}\n   225→            >\n   226→              <div className=\"flex items-center space-x-2 mt-2\">\n   227→                <RadioGroupItem value=\"member\" id=\"member\" />\n   228→                <Label htmlFor=\"member\">Member</Label>\n   229→              </div>\n   230→              <div className=\"flex items-center space-x-2 mt-2\">\n   231→                <RadioGroupItem value=\"owner\" id=\"owner\" />\n   232→                <Label htmlFor=\"owner\">Owner</Label>\n   233→              </div>\n   234→            </RadioGroup>\n   235→          </div>\n   236→          {inviteState?.error && (\n   237→            <p className=\"text-red-500\">{inviteState.error}</p>\n   238→          )}\n   239→          {inviteState?.success && (\n   240→            <p className=\"text-green-500\">{inviteState.success}</p>\n   241→          )}\n   242→          <Button\n   243→            type=\"submit\"\n   244→            className=\"bg-orange-500 hover:bg-orange-600 text-white\"\n   245→            disabled={isInvitePending || !isOwner}\n   246→          >\n   247→            {isInvitePending ? (\n   248→              <>\n   249→                <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   250→                Inviting...\n   251→              </>\n   252→            ) : (\n   253→              <>\n   254→                <PlusCircle className=\"mr-2 h-4 w-4\" />\n   255→                Invite Member\n   256→              </>\n   257→            )}\n   258→          </Button>\n   259→        </form>\n   260→      </CardContent>\n   261→      {!isOwner && (\n   262→        <CardFooter>\n   263→          <p className=\"text-sm text-muted-foreground\">\n   264→            You must be a team owner to invite new members.\n   265→          </p>\n   266→        </CardFooter>\n   267→      )}\n   268→    </Card>\n   269→  );\n   270→}\n   271→\n   272→export default function SettingsPage() {\n   273→  return (\n   274→    <section className=\"flex-1 p-4 lg:p-8\">\n   275→      <h1 className=\"text-lg lg:text-2xl font-medium mb-6\">Team Settings</h1>\n   276→      <Suspense fallback={<SubscriptionSkeleton />}>\n   277→        <ManageSubscription />\n   278→      </Suspense>\n   279→      <Suspense fallback={<TeamMembersSkeleton />}>\n   280→        <TeamMembers />\n   281→      </Suspense>\n   282→      <Suspense fallback={<InviteTeamMemberSkeleton />}>\n   283→        <InviteTeamMember />\n   284→      </Suspense>\n   285→    </section>\n   286→  );\n   287→}\n   288→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
