        "content": "     1→'use server';\n     2→\n     3→import { z } from 'zod';\n     4→import { and, eq, sql } from 'drizzle-orm';\n     5→import { db } from '@/lib/db/drizzle';\n     6→import {\n     7→  User,\n     8→  users,\n     9→  teams,\n    10→  teamMembers,\n    11→  activityLogs,\n    12→  type NewUser,\n    13→  type NewTeam,\n    14→  type NewTeamMember,\n    15→  type NewActivityLog,\n    16→  ActivityType,\n    17→  invitations\n    18→} from '@/lib/db/schema';\n    19→import { comparePasswords, hashPassword, setSession } from '@/lib/auth/session';\n    20→import { redirect } from 'next/navigation';\n    21→import { cookies } from 'next/headers';\n    22→import { createCheckoutSession } from '@/lib/payments/stripe';\n    23→import { getUser, getUserWithTeam } from '@/lib/db/queries';\n    24→import {\n    25→  validatedAction,\n    26→  validatedActionWithUser\n    27→} from '@/lib/auth/middleware';\n    28→\n    29→async function logActivity(\n    30→  teamId: number | null | undefined,\n    31→  userId: number,\n    32→  type: ActivityType,\n    33→  ipAddress?: string\n    34→) {\n    35→  if (teamId === null || teamId === undefined) {\n    36→    return;\n    37→  }\n    38→  const newActivity: NewActivityLog = {\n    39→    teamId,\n    40→    userId,\n    41→    action: type,\n    42→    ipAddress: ipAddress || ''\n    43→  };\n    44→  await db.insert(activityLogs).values(newActivity);\n    45→}\n    46→\n    47→const signInSchema = z.object({\n    48→  email: z.string().email().min(3).max(255),\n    49→  password: z.string().min(8).max(100)\n    50→});\n    51→\n    52→export const signIn = validatedAction(signInSchema, async (data, formData) => {\n    53→  const { email, password } = data;\n    54→\n    55→  const userWithTeam = await db\n    56→    .select({\n    57→      user: users,\n    58→      team: teams\n    59→    })\n    60→    .from(users)\n    61→    .leftJoin(teamMembers, eq(users.id, teamMembers.userId))\n    62→    .leftJoi