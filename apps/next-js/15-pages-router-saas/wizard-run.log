tion.data;\n    62→    const userWithTeam = await getUserWithTeam(user.id);\n    63→\n    64→    if (!userWithTeam?.teamId) {\n    65→      return res.status(400).json({ error: 'User is not part of a team' });\n    66→    }\n    67→\n    68→    const existingMember = await db\n    69→      .select()\n    70→      .from(users)\n    71→      .leftJoin(teamMembers, eq(users.id, teamMembers.userId))\n    72→      .where(\n    73→        and(eq(users.email, email), eq(teamMembers.teamId, userWithTeam.teamId))\n    74→      )\n    75→      .limit(1);\n    76→\n    77→    if (existingMember.length > 0) {\n    78→      return res.status(400).json({ error: 'User is already a member of this team' });\n    79→    }\n    80→\n    81→    const existingInvitation = await db\n    82→      .select()\n    83→      .from(invitations)\n    84→      .where(\n    85→        and(\n    86→          eq(invitations.email, email),\n    87→          eq(invitations.teamId, userWithTeam.teamId),\n    88→          eq(invitations.status, 'pending')\n    89→        )\n    90→      )\n    91→      .limit(1);\n    92→\n    93→    if (existingInvitation.length > 0) {\n    94→      return res.status(400).json({ error: 'An invitation has already been sent to this email' });\n    95→    }\n    96→\n    97→    await db.insert(invitations).values({\n    98→      teamId: userWithTeam.teamId,\n    99→      email,\n   100→      role,\n   101→      invitedBy: user.id,\n   102→      status: 'pending'\n   103→    });\n   104→\n   105→    await logActivity(\n   106→      userWithTeam.teamId,\n   107→      user.id,\n   108→      ActivityType.INVITE_TEAM_MEMBER\n   109→    );\n   110→\n   111→    return res.status(200).json({ success: 'Invitation sent successfully' });\n   112→  } catch (error) {\n   113→    console.error('Invite team member error:', error);\n   114→    return res.status(500).json({ error: 'Failed to invite team member' });\n   115→  }\n   116→}\n   117→\n\n<system-reminder>\nWhenever you read a f