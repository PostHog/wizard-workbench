rSideProps = async (context) => {\n  const { req } = context;\n  const sessionCookie = req.cookies.session;\n\n  if (!sessionCookie) {\n    return {\n      redirect: {\n        destination: '/sign-in',\n        permanent: false\n      }\n    };\n  }\n\n  try {\n    await verifyToken(sessionCookie);\n  } catch (error) {\n    return {\n      redirect: {\n        destination: '/sign-in',\n        permanent: false\n      }\n    };\n  }\n\n  return {\n    props: {}\n  };\n};\n",
