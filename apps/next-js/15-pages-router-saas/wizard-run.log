tId) {\n    55→      throw new Error('No product ID found for this subscription.');\n    56→    }\n    57→\n    58→    const userId = session.client_reference_id;\n    59→    if (!userId) {\n    60→      throw new Error(\"No user ID found in session's client_reference_id.\");\n    61→    }\n    62→\n    63→    const user = await db\n    64→      .select()\n    65→      .from(users)\n    66→      .where(eq(users.id, Number(userId)))\n    67→      .limit(1);\n    68→\n    69→    if (user.length === 0) {\n    70→      throw new Error('User not found in database.');\n    71→    }\n    72→\n    73→    const userTeam = await db\n    74→      .select({\n    75→        teamId: teamMembers.teamId\n    76→      })\n    77→      .from(teamMembers)\n    78→      .where(eq(teamMembers.userId, user[0].id))\n    79→      .limit(1);\n    80→\n    81→    if (userTeam.length === 0) {\n    82→      throw new Error('User is not associated with any team.');\n    83→    }\n    84→\n    85→    await db\n    86→      .update(teams)\n    87→      .set({\n    88→        stripeCustomerId: customerId,\n    89→        stripeSubscriptionId: subscriptionId,\n    90→        stripeProductId: productId,\n    91→        planName: (plan.product as Stripe.Product).name,\n    92→        subscriptionStatus: subscription.status,\n    93→        updatedAt: new Date()\n    94→      })\n    95→      .where(eq(teams.id, userTeam[0].teamId));\n    96→\n    97→    await setSession(user[0]);\n    98→    return res.redirect('/dashboard');\n    99→  } catch (error) {\n   100→    console.error('Error handling successful checkout:', error);\n   101→    return res.redirect('/error');\n   102→  }\n   103→}\n   104→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the 