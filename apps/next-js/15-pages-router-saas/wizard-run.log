→      </ul>\n   120→      <form onSubmit={handleSubmit}>\n   121→        <input type=\"hidden\" name=\"priceId\" value={priceId} />\n   122→        <SubmitButton isPending={isPending} />\n   123→      </form>\n   124→    </div>\n   125→  );\n   126→}\n   127→\n   128→export default function PricingPage({\n   129→  prices,\n   130→  products,\n   131→  fallback\n   132→}: PricingPageProps) {\n   133→  const basePlan = products.find((product) => product.name === 'Base');\n   134→  const plusPlan = products.find((product) => product.name === 'Plus');\n   135→\n   136→  const basePrice = prices.find((price) => price.productId === basePlan?.id);\n   137→  const plusPrice = prices.find((price) => price.productId === plusPlan?.id);\n   138→\n   139→  return (\n   140→    <div className=\"flex flex-col min-h-screen\">\n   141→      <Header />\n   142→      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n   143→        <div className=\"grid md:grid-cols-2 gap-8 max-w-xl mx-auto\">\n   144→          <PricingCard\n   145→            name={basePlan?.name || 'Base'}\n   146→            price={basePrice?.unitAmount || 800}\n   147→            interval={basePrice?.interval || 'month'}\n   148→            trialDays={basePrice?.trialPeriodDays || 7}\n   149→            features={[\n   150→              'Unlimited Usage',\n   151→              'Unlimited Workspace Members',\n   152→              'Email Support'\n   153→            ]}\n   154→            priceId={basePrice?.id}\n   155→          />\n   156→          <PricingCard\n   157→            name={plusPlan?.name || 'Plus'}\n   158→            price={plusPrice?.unitAmount || 1200}\n   159→            interval={plusPrice?.interval || 'month'}\n   160→            trialDays={plusPrice?.trialPeriodDays || 7}\n   161→            features={[\n   162→              'Everything in Base, and:',\n   163→              'Early Access to New Features',\n   164→              '24/7 Support + Slack Access'\n   165→            ]}\n   166→            priceId={plusPrice?.id}\n   167→          />\n   168→        </div>\n   169→      </main>\n   170→    </div>\n   171→  );\n   172→}\n   173→\n   174→export const getServerSideProps: GetServerSideProps = async (context) => {\n   175→  const sessionCookie = context.req.cookies.session;\n   176→  const [prices, products, user] = await Promise.all([\n   177→    getStripePrices(),\n   178→    getStripeProducts(),\n   179→    getUser(sessionCookie)\n   180→  ]);\n   181→\n   182→  const team = user ? await getTeamForUser(sessionCookie) : null;\n   183→\n   184→  return {\n   185→    props: {\n   186→      prices,\n   187→      products,\n   188→      fallback: {\n   189→        '/api/user': user ? JSON.parse(JSON.stringify(user)) : null,\n   190→        '/api/team': team ? JSON.parse(JSON.stringify(team)) : null\n   191→      }\n   192→    }\n   193→  };\n   194→};\n   195→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
