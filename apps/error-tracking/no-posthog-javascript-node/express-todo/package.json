{
  "name": "express-todo",
  "version": "1.0.0",
  "description": "An Express todo API for testing the javascript_node wizard skill",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:production": "node dist/index.js",
    "build": "esbuild index.js --bundle --platform=node --format=cjs --packages=external --sourcemap --sources-content=true --outfile=dist/index.js",
    "dev": "node --watch index.js"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
