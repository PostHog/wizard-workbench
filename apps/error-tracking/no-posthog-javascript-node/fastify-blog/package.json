{
  "name": "fastify-blog",
  "version": "1.0.0",
  "type": "module",
  "description": "A Fastify blog API for testing the javascript_node wizard skill",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:production": "node dist/index.js",
    "build": "esbuild index.js --bundle --platform=node --format=esm --packages=external --sourcemap --sources-content=true --outfile=dist/index.js",
    "dev": "node --watch index.js"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
