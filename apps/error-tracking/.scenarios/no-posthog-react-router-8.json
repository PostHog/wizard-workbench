{
  "app": "no-posthog-react-router-8",
  "lifecycle": {
    "install": {
      "argv": [
        "npm",
        "ci",
        "--no-audit",
        "--no-fund"
      ]
    },
    "build": {
      "argv": [
        "npm",
        "run",
        "build"
      ]
    },
    "start": {
      "argv": [
        "node",
        "--env-file-if-exists=.env",
        "--env-file-if-exists=.env.local",
        "--env-file-if-exists=.env.production",
        "node_modules/@react-router/serve/dist/cli.js",
        "./build/server/index.js"
      ],
      "ready": {
        "path": "/",
        "timeoutMs": 60000
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "env": {},
    "flushWaitMs": 15000
  },
  "scenarios": [
    {
      "id": "client-render-route",
      "surface": "Client render error caught by the route ErrorBoundary (framework mode, HydratedRouter)",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/suppliers?view=map",
        "waitMs": 2500,
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "MP14",
        "file": "app/components/supplier-map.tsx"
      },
      "expect": {
        "count": 1,
        "lib": "web",
        "linked": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/components/supplier-map.tsx"
        }
      }
    },
    {
      "id": "client-loader",
      "surface": "clientLoader throws on a client navigation",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/",
        "actions": [
          {
            "wait": 1500
          },
          {
            "click": "a:has-text('ORD-7731')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "OC31",
        "file": "app/routes/order.tsx"
      },
      "expect": {
        "count": 1,
        "lib": "web",
        "linked": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/routes/order.tsx"
        }
      }
    },
    {
      "id": "client-onclick",
      "surface": "Event handler throw",
      "requirement": "COV-1",
      "trigger": {
        "kind": "browser",
        "page": "/products",
        "actions": [
          {
            "wait": 1500
          },
          {
            "click": "button:has-text('Export CSV')"
          },
          {
            "wait": 1000
          }
        ],
        "expectPageError": "CE03"
      },
      "throws": {
        "match": "CE03",
        "file": "app/lib/csv.ts"
      },
      "expect": {
        "count": 1,
        "lib": "web",
        "linked": true,
        "handled": false,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/csv.ts"
        }
      }
    },
    {
      "id": "loader-document",
      "surface": "Server loader throws on a document navigation (cookie only)",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/",
        "actions": [
          {
            "wait": 2500
          },
          {
            "goto": "/products/SKU-4471"
          },
          {
            "wait": 1500
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "LB71",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "loader-client-nav",
      "surface": "Server loader throws on a client navigation (single-fetch .data request)",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/products",
        "actions": [
          {
            "wait": 2000
          },
          {
            "click": "a:has-text('SKU-4480')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "LB80",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "action-form",
      "surface": "Server action throws, submitted from a <Form>",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/products/SKU-2202",
        "actions": [
          {
            "wait": 2000
          },
          {
            "evaluate": "document.querySelector('select[name=reason]').value = 'recount'"
          },
          {
            "fill": {
              "selector": "input[name=quantity]",
              "value": "3"
            }
          },
          {
            "click": "button:has-text('Save adjustment')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "RC02",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "fetcher-action",
      "surface": "Resource route action throws, submitted by useFetcher",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/products",
        "actions": [
          {
            "wait": 2000
          },
          {
            "click": "button:has-text('Reorder SKU-3003')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "RO03",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "ssr-render-document",
      "surface": "SSR render error in the shell, document navigation (cookie only)",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/",
        "actions": [
          {
            "wait": 2500
          },
          {
            "goto": "/reports?range=q5"
          },
          {
            "wait": 1500
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "RX20",
        "file": "app/lib/reports.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/reports.ts"
        }
      }
    },
    {
      "id": "streamed-rejection",
      "surface": "Deferred loader promise rejects after the shell streamed (<Await> without errorElement)",
      "requirement": "COV-2",
      "trigger": {
        "kind": "browser",
        "page": "/",
        "actions": [
          {
            "wait": 2500
          },
          {
            "goto": "/reports/forecast?region=eu-2"
          },
          {
            "wait": 2500
          }
        ],
        "expectText": "Something went wrong"
      },
      "throws": {
        "match": "FC22",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "resource-route-headers",
      "surface": "Resource route loader throws, request with X-POSTHOG-* tracing headers",
      "requirement": "CTX-1",
      "trigger": {
        "kind": "http",
        "path": "/api/products/SKU-5150/label",
        "identity": "headers",
        "expectStatus": 500
      },
      "throws": {
        "match": "PD50",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "middleware-cookie",
      "surface": "Route middleware throws, page request carrying only the PostHog cookie",
      "requirement": "COV-2",
      "trigger": {
        "kind": "http",
        "path": "/stores/~bad",
        "identity": "cookie",
        "expectStatus": 500
      },
      "throws": {
        "match": "TN09",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "linked": true,
        "request": true,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    },
    {
      "id": "not-found-loader",
      "surface": "Loader throws data(\u2026, { status: 404 }) on a document request",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "browser",
        "page": "/products/SKU-9999",
        "waitMs": 2500,
        "expectText": "Product not found"
      },
      "throws": {
        "urlMatch": "/products/SKU-9999"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "unknown-route",
      "surface": "No route matches (router-internal 404: handleError and onError both receive it)",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "browser",
        "page": "/warehouse/aisle-9",
        "waitMs": 2500,
        "expectText": "Not found"
      },
      "throws": {
        "match": "/warehouse/aisle-9",
        "urlMatch": "/warehouse/aisle-9"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "action-validation",
      "surface": "Action throws data(\u2026, { status: 400 }) for invalid input",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "browser",
        "page": "/products/SKU-1001",
        "actions": [
          {
            "wait": 2000
          },
          {
            "fill": {
              "selector": "input[name=quantity]",
              "value": "-5"
            }
          },
          {
            "click": "button:has-text('Save adjustment')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Quantity must be a positive whole number"
      },
      "throws": {
        "urlMatch": "/products/SKU-1001"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "action-redirect",
      "surface": "Action throws redirect() after a successful adjustment",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "browser",
        "page": "/products/SKU-1002",
        "actions": [
          {
            "wait": 2000
          },
          {
            "fill": {
              "selector": "input[name=quantity]",
              "value": "4"
            }
          },
          {
            "click": "button:has-text('Save adjustment')"
          },
          {
            "wait": 2000
          }
        ],
        "expectText": "Stock updated"
      },
      "throws": {
        "urlMatch": "/products/SKU-1002"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "not-found-resource",
      "surface": "Resource route throws data(\u2026, { status: 404 })",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "http",
        "path": "/api/products/SKU-9999/label",
        "identity": "headers",
        "expectStatus": 404
      },
      "throws": {
        "urlMatch": "/api/products/SKU-9999"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "method-not-allowed",
      "surface": "POST to a route with no action (router-internal 405 reaches handleError)",
      "requirement": "PRE-2",
      "trigger": {
        "kind": "http",
        "method": "POST",
        "path": "/reports?range=q1",
        "identity": "cookie",
        "expectStatus": 405
      },
      "throws": {
        "match": "did not provide an `action`",
        "urlMatch": "/reports?range=q1"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "background-rejection",
      "surface": "Fire-and-forget promise in an action rejects (process unhandledRejection; react-router-serve has no listener, so the process exits: keep last)",
      "requirement": "COV-1",
      "trigger": {
        "kind": "http",
        "method": "POST",
        "path": "/api/sync",
        "body": {
          "batch": "EX-77"
        },
        "identity": "headers",
        "expectStatus": 202
      },
      "throws": {
        "match": "EX77",
        "file": "app/lib/inventory.server.ts"
      },
      "expect": {
        "count": 1,
        "lib": "posthog-node",
        "handled": false,
        "release": true,
        "topFrame": {
          "resolved": true,
          "sourceEndsWith": "app/lib/inventory.server.ts"
        }
      }
    }
  ]
}
