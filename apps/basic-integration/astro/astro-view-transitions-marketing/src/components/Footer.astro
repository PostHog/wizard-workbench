---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link" data-footer-link="features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-footer-link="pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-footer-link="about">About</a></li>
      <li><a href="/docs" class="footer-link" data-footer-link="docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-footer-link="privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-footer-link="terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  function trackFooterClick(event) {
    const target = event.currentTarget;

    window.posthog?.capture('footer_link_clicked', {
      link_name: target?.dataset?.footerLink,
      href: target?.getAttribute('href') || undefined,
      page_path: window.location.pathname
    });
  }

  function setupFooterTracking() {
    const footerLinks = document.querySelectorAll('[data-footer-link]');

    footerLinks.forEach((link) => {
      link.removeEventListener('click', trackFooterClick);
      link.addEventListener('click', trackFooterClick);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooterTracking);
  document.addEventListener('astro:page-load', setupFooterTracking);
</script>
