---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link" data-footer-link="Features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-footer-link="Pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-footer-link="About">About</a></li>
      <li><a href="/docs" class="footer-link" data-footer-link="Docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-footer-link="Privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-footer-link="Terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  function handleFooterLinkClick(event) {
    var label = event.currentTarget.getAttribute('data-footer-link');
    window.posthog?.capture('footer_link_clicked', { link: label });
  }

  function setupFooterEvents() {
    var footerLinks = document.querySelectorAll('[data-footer-link]');
    footerLinks.forEach(function(link) {
      link.removeEventListener('click', handleFooterLinkClick);
      link.addEventListener('click', handleFooterLinkClick);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooterEvents);
  document.addEventListener('astro:page-load', setupFooterEvents);
</script>
