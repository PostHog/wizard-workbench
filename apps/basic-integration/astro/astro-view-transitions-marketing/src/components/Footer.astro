---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link" data-footer-label="features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-footer-label="pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-footer-label="about">About</a></li>
      <li><a href="/docs" class="footer-link" data-footer-label="docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-footer-label="privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-footer-label="terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  function onFooterLinkClick(event) {
    var label = event.currentTarget.getAttribute('data-footer-label');
    window.posthog?.capture('footer_link_clicked', { link: label });
  }

  function setupFooter() {
    var footerLinks = document.querySelectorAll('[data-footer-label]');
    footerLinks.forEach(function(link) {
      link.removeEventListener('click', onFooterLinkClick);
      link.addEventListener('click', onFooterLinkClick);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooter);
  document.addEventListener('astro:page-load', setupFooter);
</script>
