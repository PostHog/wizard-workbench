---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link">Features</a></li>
      <li><a href="/pricing" class="footer-link">Pricing</a></li>
      <li><a href="/about" class="footer-link">About</a></li>
      <li><a href="/docs" class="footer-link">Docs</a></li>
      <li><a href="#" class="footer-link">Privacy</a></li>
      <li><a href="#" class="footer-link">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  function setupFooter() {
    var links = document.querySelectorAll('.footer-link');
    links.forEach(function(link) {
      link.removeEventListener('click', link._phHandler);
      link._phHandler = function() {
        window.posthog?.capture('footer_link_clicked', { link_text: link.textContent?.trim() });
      };
      link.addEventListener('click', link._phHandler);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooter);
  document.addEventListener('astro:page-load', setupFooter);
</script>
