---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" data-posthog-get-started>Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  function bindGetStartedCapture() {
    document.querySelectorAll('[data-posthog-get-started]').forEach((cta) => {
      if (cta.dataset.posthogBound) return;

      cta.dataset.posthogBound = 'true';
      cta.addEventListener('click', () => {
        window.posthog?.capture('get_started_cta_clicked', {
          placement: 'navigation',
        });
        window.posthog?.logger?.info('marketing CTA selected', {
          cta: 'get_started',
          placement: 'navigation',
        });
      });
    });
  }

  bindGetStartedCapture();
  document.addEventListener('astro:page-load', bindGetStartedCapture);
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
