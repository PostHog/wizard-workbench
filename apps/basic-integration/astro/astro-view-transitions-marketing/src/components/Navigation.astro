---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" data-posthog-event="get_started_cta_clicked" data-cta-location="navigation">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  if (!window.__posthog_cta_listener_initialized) {
    window.__posthog_cta_listener_initialized = true;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      const cta = event.target.closest('[data-posthog-event]');
      if (!cta) return;

      const { posthogEvent, ctaLocation, plan } = cta.dataset;
      const attributes = {
        cta_location: ctaLocation,
        ...(plan && { plan }),
      };

      window.posthog?.capture(posthogEvent, attributes);
      window.posthog?.logger?.info('marketing CTA selected', {
        event_name: posthogEvent,
        ...attributes,
      });
    });
  }
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
