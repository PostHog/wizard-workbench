---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]} data-posthog-nav="features">Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]} data-posthog-nav="pricing">Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]} data-posthog-nav="about">About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]} data-posthog-nav="docs">Docs</a></li>
      <li><a href="#" class="nav-cta" data-posthog-get-started>Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.querySelectorAll('[data-posthog-nav]').forEach((link) => {
    link.addEventListener('click', () => {
      window.posthog?.capture('navigation_link_clicked', {
        destination: link.dataset.posthogNav,
        location: 'primary_navigation',
      });
    });
  });

  document.querySelector('[data-posthog-get-started]')?.addEventListener('click', () => {
    window.posthog?.capture('get_started_clicked', {
      location: 'primary_navigation',
    });
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
