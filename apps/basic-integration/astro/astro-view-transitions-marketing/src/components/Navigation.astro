---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" data-ph-event="nav_cta_clicked" data-ph-location="navigation" data-ph-cta="get_started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  function trackNavigationCta(event) {
    const target = event.currentTarget;

    window.posthog?.capture('nav_cta_clicked', {
      location: target?.dataset?.phLocation,
      cta_name: target?.dataset?.phCta,
      href: target?.getAttribute('href') || undefined,
      page_path: window.location.pathname
    });
  }

  function setupNavigationTracking() {
    const ctaLink = document.querySelector('.nav-cta');

    ctaLink?.removeEventListener('click', trackNavigationCta);
    ctaLink?.addEventListener('click', trackNavigationCta);
  }

  document.addEventListener('DOMContentLoaded', setupNavigationTracking);
  document.addEventListener('astro:page-load', setupNavigationTracking);
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
