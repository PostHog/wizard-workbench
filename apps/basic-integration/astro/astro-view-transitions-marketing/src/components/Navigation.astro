---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  if (!window.__posthogNavigationCaptureBound) {
    window.__posthogNavigationCaptureBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target.closest('.nav-cta');
      if (!target) return;

      window.posthog?.capture('get_started_clicked', {
        location: 'navigation',
      });
    });
  }
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
