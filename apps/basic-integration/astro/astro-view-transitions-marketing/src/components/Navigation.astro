---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" data-posthog-event="get_started_cta_clicked">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  if (!window.__posthog_navigation_cta_listener) {
    window.__posthog_navigation_cta_listener = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('[data-posthog-event="get_started_cta_clicked"]')) {
        window.posthog?.capture('get_started_cta_clicked', {
          location: 'navigation',
        });
        window.posthog?.logger?.info('marketing navigation CTA clicked', {
          location: 'navigation',
        });
      }
    });
  }
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
