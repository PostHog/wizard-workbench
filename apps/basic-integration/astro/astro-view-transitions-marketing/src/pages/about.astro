---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about NeuralFlow and our mission to make AI accessible for everyone.">
  <div class="page-header">
    <div class="container">
      <h1>About NeuralFlow</h1>
      <p>We're on a mission to make AI-powered automation accessible to every team.</p>
    </div>
  </div>

  <section class="about-content">
    <div class="container">
      <p style="font-size: 1.25rem; color: var(--color-text-muted); max-width: 800px; margin: 0 auto; text-align: center;">
        Founded in 2023, NeuralFlow started with a simple idea: AI should make work easier, not harder.
        We've built a platform that brings the power of modern AI to everyday workflows,
        helping teams focus on what matters most.
      </p>

      <div class="about-grid">
        <button type="button" class="about-card about-card-button" data-posthog-stat="active-users">
          <h3>10K+</h3>
          <p>Active Users</p>
        </button>
        <button type="button" class="about-card about-card-button" data-posthog-stat="documents-processed">
          <h3>500M+</h3>
          <p>Documents Processed</p>
        </button>
        <button type="button" class="about-card about-card-button" data-posthog-stat="uptime-sla">
          <h3>99.9%</h3>
          <p>Uptime SLA</p>
        </button>
        <button type="button" class="about-card about-card-button" data-posthog-stat="countries">
          <h3>50+</h3>
          <p>Countries</p>
        </button>
      </div>
    </div>
  </section>

  <section class="team-section" style="background: var(--color-bg-secondary); padding: 4rem 0;">
    <div class="container">
      <div class="section-header">
        <h2>Meet the Team</h2>
        <p>The people building the future of work</p>
      </div>
      <div class="team-grid">
        <div class="team-member">
          <div class="team-avatar">👩‍💻</div>
          <h4>Sarah Chen</h4>
          <p>CEO & Co-founder</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👨‍💻</div>
          <h4>Marcus Johnson</h4>
          <p>CTO & Co-founder</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👩‍🔬</div>
          <h4>Dr. Emily Park</h4>
          <p>Head of AI Research</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👨‍🎨</div>
          <h4>Alex Rivera</h4>
          <p>Head of Design</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function setupAboutTracking() {
    window.NeuralFlowAnalytics?.attachClickTracking('[data-posthog-stat]', (element) => ({
      event: 'about_stat_highlight_clicked',
      properties: {
        stat_name: element.getAttribute('data-posthog-stat') || 'unknown'
      }
    }));
  }

  document.addEventListener('DOMContentLoaded', setupAboutTracking);
  document.addEventListener('astro:page-load', setupAboutTracking);
</script>

<style>
  .about-card-button {
    width: 100%;
    border: 0;
    background: none;
    padding: 0;
    text-align: inherit;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
</style>
