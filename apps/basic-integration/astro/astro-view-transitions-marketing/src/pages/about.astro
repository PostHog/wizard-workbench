---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about NeuralFlow and our mission to make AI accessible for everyone.">
  <div class="page-header">
    <div class="container">
      <h1>About NeuralFlow</h1>
      <p>We're on a mission to make AI-powered automation accessible to every team.</p>
    </div>
  </div>

  <section class="about-content">
    <div class="container">
      <p style="font-size: 1.25rem; color: var(--color-text-muted); max-width: 800px; margin: 0 auto; text-align: center;">
        Founded in 2023, NeuralFlow started with a simple idea: AI should make work easier, not harder.
        We've built a platform that brings the power of modern AI to everyday workflows,
        helping teams focus on what matters most.
      </p>

      <div class="about-grid" id="about-stats-grid">
        <div class="about-card">
          <h3>10K+</h3>
          <p>Active Users</p>
        </div>
        <div class="about-card">
          <h3>500M+</h3>
          <p>Documents Processed</p>
        </div>
        <div class="about-card">
          <h3>99.9%</h3>
          <p>Uptime SLA</p>
        </div>
        <div class="about-card">
          <h3>50+</h3>
          <p>Countries</p>
        </div>
      </div>
    </div>
  </section>

  <section class="team-section" style="background: var(--color-bg-secondary); padding: 4rem 0;">
    <div class="container">
      <div class="section-header">
        <h2>Meet the Team</h2>
        <p>The people building the future of work</p>
      </div>
      <div class="team-grid">
        <div class="team-member">
          <div class="team-avatar">👩‍💻</div>
          <h4>Sarah Chen</h4>
          <p>CEO & Co-founder</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👨‍💻</div>
          <h4>Marcus Johnson</h4>
          <p>CTO & Co-founder</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👩‍🔬</div>
          <h4>Dr. Emily Park</h4>
          <p>Head of AI Research</p>
        </div>
        <div class="team-member">
          <div class="team-avatar">👨‍🎨</div>
          <h4>Alex Rivera</h4>
          <p>Head of Design</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function setupAboutTracking() {
    const statsGrid = document.getElementById('about-stats-grid');

    if (!statsGrid || statsGrid.dataset.phTracked === 'true') {
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || statsGrid.dataset.phTracked === 'true') {
          return;
        }

        statsGrid.dataset.phTracked = 'true';
        window.posthog?.capture('about_stats_viewed', {
          section_name: 'company_stats',
          page_name: 'about'
        });
        observer.disconnect();
      });
    }, { threshold: 0.5 });

    observer.observe(statsGrid);
  }

  document.addEventListener('DOMContentLoaded', setupAboutTracking);
  document.addEventListener('astro:page-load', setupAboutTracking);
</script>
