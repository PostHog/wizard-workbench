---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing" description="Simple, transparent pricing for teams of all sizes.">
  <div class="page-header">
    <div class="container">
      <h1>Pricing</h1>
      <p>Simple, transparent pricing. No hidden fees.</p>
    </div>
  </div>

  <section class="pricing">
    <div class="container">
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Starter</h3>
          <div class="price">$29<span>/month</span></div>
          <p class="description">Perfect for individuals and small teams getting started.</p>
          <ul class="pricing-features">
            <li>Up to 5 team members</li>
            <li>1,000 AI requests/month</li>
            <li>10GB storage</li>
            <li>Basic integrations</li>
            <li>Email support</li>
          </ul>
          <a href="#" class="btn btn-secondary" style="width: 100%; justify-content: center;" id="starter-cta-btn">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <h3>Pro</h3>
          <div class="price">$99<span>/month</span></div>
          <p class="description">For growing teams that need more power and flexibility.</p>
          <ul class="pricing-features">
            <li>Up to 25 team members</li>
            <li>10,000 AI requests/month</li>
            <li>100GB storage</li>
            <li>All integrations</li>
            <li>Priority support</li>
            <li>Advanced analytics</li>
            <li>Custom workflows</li>
          </ul>
          <a href="#" class="btn btn-primary" style="width: 100%; justify-content: center;" id="pro-trial-btn">Start Free Trial</a>
        </div>

        <div class="pricing-card">
          <h3>Enterprise</h3>
          <div class="price">Custom</div>
          <p class="description">For large organizations with custom requirements.</p>
          <ul class="pricing-features">
            <li>Unlimited team members</li>
            <li>Unlimited AI requests</li>
            <li>Unlimited storage</li>
            <li>Custom integrations</li>
            <li>Dedicated support</li>
            <li>SLA guarantees</li>
            <li>On-premise deployment</li>
            <li>Custom training</li>
          </ul>
          <a href="#" class="btn btn-secondary" style="width: 100%; justify-content: center;" id="enterprise-contact-btn">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function setupPricingPage() {
      window.posthog?.capture('pricing_page_viewed');

      var starterBtn = document.getElementById('starter-cta-btn');
      var proBtn = document.getElementById('pro-trial-btn');
      var enterpriseBtn = document.getElementById('enterprise-contact-btn');

      starterBtn?.removeEventListener('click', handleStarterClick);
      starterBtn?.addEventListener('click', handleStarterClick);

      proBtn?.removeEventListener('click', handleProClick);
      proBtn?.addEventListener('click', handleProClick);

      enterpriseBtn?.removeEventListener('click', handleEnterpriseClick);
      enterpriseBtn?.addEventListener('click', handleEnterpriseClick);
    }

    function handleStarterClick() {
      window.posthog?.capture('starter_plan_cta_clicked', { plan: 'starter', price: '$29/month' });
    }

    function handleProClick() {
      window.posthog?.capture('pro_trial_cta_clicked', { plan: 'pro', price: '$99/month' });
    }

    function handleEnterpriseClick() {
      window.posthog?.capture('enterprise_contact_sales_clicked', { plan: 'enterprise', price: 'custom' });
    }

    document.addEventListener('DOMContentLoaded', setupPricingPage);
    document.addEventListener('astro:page-load', setupPricingPage);
  </script>
</Layout>
