---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing" description="Simple, transparent pricing for teams of all sizes.">
  <div class="page-header">
    <div class="container">
      <h1>Pricing</h1>
      <p>Simple, transparent pricing. No hidden fees.</p>
    </div>
  </div>

  <section class="pricing">
    <div class="container">
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Starter</h3>
          <div class="price">$29<span>/month</span></div>
          <p class="description">Perfect for individuals and small teams getting started.</p>
          <ul class="pricing-features">
            <li>Up to 5 team members</li>
            <li>1,000 AI requests/month</li>
            <li>10GB storage</li>
            <li>Basic integrations</li>
            <li>Email support</li>
          </ul>
          <a href="#" class="btn btn-secondary" style="width: 100%; justify-content: center;" data-plan="starter" data-plan-price="29">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <h3>Pro</h3>
          <div class="price">$99<span>/month</span></div>
          <p class="description">For growing teams that need more power and flexibility.</p>
          <ul class="pricing-features">
            <li>Up to 25 team members</li>
            <li>10,000 AI requests/month</li>
            <li>100GB storage</li>
            <li>All integrations</li>
            <li>Priority support</li>
            <li>Advanced analytics</li>
            <li>Custom workflows</li>
          </ul>
          <a href="#" class="btn btn-primary" style="width: 100%; justify-content: center;" data-plan="pro" data-plan-price="99">Start Free Trial</a>
        </div>

        <div class="pricing-card">
          <h3>Enterprise</h3>
          <div class="price">Custom</div>
          <p class="description">For large organizations with custom requirements.</p>
          <ul class="pricing-features">
            <li>Unlimited team members</li>
            <li>Unlimited AI requests</li>
            <li>Unlimited storage</li>
            <li>Custom integrations</li>
            <li>Dedicated support</li>
            <li>SLA guarantees</li>
            <li>On-premise deployment</li>
            <li>Custom training</li>
          </ul>
          <a href="#" class="btn btn-secondary" style="width: 100%; justify-content: center;" id="enterprise-contact-btn">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function onPlanClick(event) {
      var btn = event.currentTarget;
      var plan = btn.getAttribute('data-plan');
      var price = parseInt(btn.getAttribute('data-plan-price') || '0', 10);
      window.posthog?.capture('pricing_plan_selected', { plan: plan, plan_price: price });
    }

    function onEnterpriseClick() {
      window.posthog?.capture('enterprise_contact_requested');
    }

    function setupPricingPage() {
      var planBtns = document.querySelectorAll('[data-plan]');
      planBtns.forEach(function(btn) {
        btn.removeEventListener('click', onPlanClick);
        btn.addEventListener('click', onPlanClick);
      });

      var enterpriseBtn = document.getElementById('enterprise-contact-btn');
      enterpriseBtn?.removeEventListener('click', onEnterpriseClick);
      enterpriseBtn?.addEventListener('click', onEnterpriseClick);
    }

    document.addEventListener('DOMContentLoaded', setupPricingPage);
    // astro:page-load fires on both initial load and soft navigation
    document.addEventListener('astro:page-load', function() {
      setupPricingPage();
      window.posthog?.capture('pricing_page_viewed');
    });
  </script>
</Layout>
