---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1><span>NeuralFlow</span> Documentation</h1>
      <p class="hero-description">
        Learn how to integrate AI-powered automation into your applications.
        Comprehensive guides, API references, and best practices.
      </p>
      <div class="hero-buttons">
        <a href="/docs" class="btn btn-primary" data-posthog-home-cta="get-started">Get Started</a>
        <a href="/docs/api" class="btn btn-secondary" data-posthog-home-cta="api-reference">API Reference</a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <a href="/docs" class="feature-card">
          <h3>Quick Start Guide</h3>
          <p>Get up and running with NeuralFlow in under 5 minutes.</p>
        </a>
        <a href="/docs/concepts" class="feature-card">
          <h3>Core Concepts</h3>
          <p>Understand the fundamentals of AI-powered automation.</p>
        </a>
        <a href="/docs/workflows" class="feature-card">
          <h3>Workflow Builder</h3>
          <p>Create complex automation sequences visually.</p>
        </a>
        <a href="/docs/api" class="feature-card">
          <h3>API Reference</h3>
          <p>Complete documentation for all API endpoints.</p>
        </a>
        <a href="/docs/api/authentication" class="feature-card">
          <h3>Authentication</h3>
          <p>Secure your integrations with API keys and OAuth.</p>
        </a>
        <a href="/docs/api/endpoints" class="feature-card">
          <h3>REST Endpoints</h3>
          <p>Explore all available API endpoints and methods.</p>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p class="footer-copy">&copy; 2024 NeuralFlow AI. All rights reserved.</p>
    </div>
  </footer>
  <script is:inline>
    async function captureHomepageCtaClick(ctaName, destination) {
      const distinctId = window.posthog?.get_distinct_id?.() || null;
      const sessionId = window.posthog?.get_session_id?.() || null;

      window.posthog?.capture('homepage_cta_clicked', {
        cta_name: ctaName,
        destination,
        source: 'homepage_hero'
      });

      try {
        await fetch('/api/events/docs', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-POSTHOG-DISTINCT-ID': distinctId || '',
            'X-PostHog-Session-Id': sessionId || ''
          },
          body: JSON.stringify({
            event: 'homepage_cta_clicked',
            ctaName,
            destination,
            source: 'homepage_hero'
          })
        });
      } catch (error) {
        console.error('Failed to record homepage CTA server event', error);
        window.posthog?.captureException?.(error);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-posthog-home-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          if (!(link instanceof HTMLAnchorElement)) return;
          captureHomepageCtaClick(link.dataset.posthogHomeCta || 'unknown', link.getAttribute('href') || '');
        });
      });
    });
  </script>
</Layout>
