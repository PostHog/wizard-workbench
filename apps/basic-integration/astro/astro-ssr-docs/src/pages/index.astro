---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1><span>NeuralFlow</span> Documentation</h1>
      <p class="hero-description">
        Learn how to integrate AI-powered automation into your applications.
        Comprehensive guides, API references, and best practices.
      </p>
      <div class="hero-buttons">
        <a
          href="/docs"
          class="btn btn-primary"
          data-posthog-event="documentation_started"
          data-source="home_hero"
        >Get Started</a>
        <a
          href="/docs/api"
          class="btn btn-secondary"
          data-posthog-event="api_reference_opened"
          data-source="home_hero"
        >API Reference</a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <a href="/docs" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="quick_start">
          <h3>Quick Start Guide</h3>
          <p>Get up and running with NeuralFlow in under 5 minutes.</p>
        </a>
        <a href="/docs/concepts" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="core_concepts">
          <h3>Core Concepts</h3>
          <p>Understand the fundamentals of AI-powered automation.</p>
        </a>
        <a href="/docs/workflows" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="workflows">
          <h3>Workflow Builder</h3>
          <p>Create complex automation sequences visually.</p>
        </a>
        <a href="/docs/api" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="api_reference">
          <h3>API Reference</h3>
          <p>Complete documentation for all API endpoints.</p>
        </a>
        <a href="/docs/api/authentication" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="authentication">
          <h3>Authentication</h3>
          <p>Secure your integrations with API keys and OAuth.</p>
        </a>
        <a href="/docs/api/endpoints" class="feature-card" data-posthog-event="documentation_topic_selected" data-topic="rest_endpoints">
          <h3>REST Endpoints</h3>
          <p>Explore all available API endpoints and methods.</p>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p class="footer-copy">&copy; 2024 NeuralFlow AI. All rights reserved.</p>
    </div>
  </footer>
</Layout>

<script is:inline>
  document.querySelectorAll('[data-posthog-event]').forEach((link) => {
    link.addEventListener('click', () => {
      const { posthogEvent, source, topic } = link.dataset;
      window.posthog?.capture(posthogEvent, {
        source: source || 'home_feature_card',
        topic: topic || undefined,
      });
      window.posthog?.logger?.info('documentation link selected', {
        source: source || 'home_feature_card',
        topic: topic || undefined,
      });
    });
  });
</script>
