---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav" data-posthog-nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank">GitHub</a></li>
      <li><a href="#" class="nav-cta">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('[data-posthog-nav]')?.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (!(link instanceof HTMLAnchorElement)) return;

      const label = link.textContent?.trim() || 'unknown';
      const destination = link.getAttribute('href') || '';
      const location = link.classList.contains('nav-cta') ? 'primary_cta' : 'navigation';

      window.posthog?.capture('docs_nav_clicked', {
        link_label: label,
        destination,
        location,
        current_path: window.location.pathname,
        is_external: link.target === '_blank' || destination.startsWith('http'),
      });
    });
  });
</script>
