---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" data-posthog-navigation="home">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]} data-posthog-navigation="documentation">Documentation</a></li>
      <li><a href="/docs/api" class="nav-link" data-posthog-navigation="api_reference">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank" data-posthog-navigation="github">GitHub</a></li>
      <li><a href="#" class="nav-cta" data-posthog-navigation="get_started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.querySelectorAll('[data-posthog-navigation]').forEach((link) => {
    link.addEventListener('click', () => {
      window.posthog?.capture('documentation_navigation_clicked', {
        navigation_item: link.dataset.posthogNavigation,
        navigation_location: 'header',
        destination: link.getAttribute('href'),
      });
    });
  });
</script>
