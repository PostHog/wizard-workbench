---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank" id="nav-github-link">GitHub</a></li>
      <li><a href="#" class="nav-cta" id="nav-get-started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('nav-get-started')?.addEventListener('click', function () {
      window.posthog?.capture('docs_nav_cta_clicked', { location: 'navigation' });
    });

    document.getElementById('nav-github-link')?.addEventListener('click', function () {
      window.posthog?.capture('docs_external_link_clicked', {
        destination: 'github',
        url: 'https://github.com'
      });
    });
  });
</script>
