---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]} data-primary-navigation="documentation">Documentation</a></li>
      <li><a href="/docs/api" class="nav-link" data-primary-navigation="api_reference">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank" data-github-link>GitHub</a></li>
      <li><a href="#" class="nav-cta">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.querySelectorAll('[data-primary-navigation]').forEach((link) => {
    link.addEventListener('click', () => {
      window.posthog?.capture('documentation_navigation_clicked', {
        navigation_item: link.dataset.primaryNavigation,
        destination: link.getAttribute('href'),
      });
    });
  });

  document.querySelector('[data-github-link]')?.addEventListener('click', () => {
    window.posthog?.capture('github_repository_opened', {
      source: 'primary_navigation',
    });
  });
</script>
