---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" data-posthog-nav="home-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]} data-posthog-nav="documentation">Documentation</a></li>
      <li><a href="/docs/api" class="nav-link" data-posthog-nav="api-reference">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank" data-posthog-nav="github">GitHub</a></li>
      <li><a href="/docs" class="nav-cta" data-posthog-nav="get-started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest('[data-posthog-nav]');
    if (!(link instanceof HTMLAnchorElement)) return;

    window.posthog?.capture('docs_navigation_clicked', {
      location: 'top_navigation',
      destination: link.getAttribute('href') || '',
      link_key: link.dataset.posthogNav || 'unknown',
      external: link.target === '_blank'
    });
  });
</script>
