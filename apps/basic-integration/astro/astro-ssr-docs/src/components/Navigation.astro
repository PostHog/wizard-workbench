---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank">GitHub</a></li>
      <li><a href="#" class="nav-cta" id="get-started-cta">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.getElementById('get-started-cta')?.addEventListener('click', () => {
    window.posthog?.capture('documentation_cta_clicked');
  });
</script>
