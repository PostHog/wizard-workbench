---
import Navigation from '../components/Navigation.astro';
import PostHog from '../components/posthog.astro';
import { getPostHogDocumentationLogger } from '../lib/posthog-server-logs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'NeuralFlow Documentation - Learn how to build with AI-powered automation' } = Astro.props;

getPostHogDocumentationLogger()?.emit({
  severityText: 'INFO',
  body: 'documentation page rendered',
  attributes: {
    render_mode: 'ssr',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | NeuralFlow Docs</title>
    <PostHog />
  </head>
  <body>
    <Navigation />
    <slot />
  </body>
</html>
