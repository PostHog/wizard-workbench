---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" data-posthog-event="navigation_link_clicked" data-destination="home">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]} data-posthog-event="navigation_link_clicked" data-destination="features">Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]} data-posthog-event="navigation_link_clicked" data-destination="pricing">Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]} data-posthog-event="navigation_link_clicked" data-destination="about">About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]} data-posthog-event="navigation_link_clicked" data-destination="docs">Docs</a></li>
      <li><a href="#" class="nav-cta" data-posthog-event="header_get_started_clicked">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.querySelectorAll('.nav [data-posthog-event]').forEach((target) => {
    target.addEventListener('click', () => {
      window.posthog?.capture(target.dataset.posthogEvent, {
        location: 'header',
        destination: target.dataset.destination,
      });
    });
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
