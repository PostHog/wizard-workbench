---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link">Features</a></li>
      <li><a href="/pricing" class="footer-link">Pricing</a></li>
      <li><a href="/about" class="footer-link">About</a></li>
      <li><a href="/docs" class="footer-link">Docs</a></li>
      <li><a href="#" class="footer-link" id="footer-privacy-link">Privacy</a></li>
      <li><a href="#" class="footer-link" id="footer-terms-link">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-privacy-link')?.addEventListener('click', () => {
    window.posthog?.capture('privacy_link_clicked', { placement: 'footer' });
  });

  document.getElementById('footer-terms-link')?.addEventListener('click', () => {
    window.posthog?.capture('terms_link_clicked', { placement: 'footer' });
  });
</script>
