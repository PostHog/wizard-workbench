---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="about">About</a></li>
      <li><a href="/docs" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-posthog-event="footer_link_clicked" data-destination="terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('.footer [data-posthog-event]').forEach((target) => {
    target.addEventListener('click', () => {
      window.posthog?.capture(target.dataset.posthogEvent, {
        location: 'footer',
        destination: target.dataset.destination,
      });
    });
  });
</script>
