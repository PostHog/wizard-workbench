---
const currentYear = new Date().getFullYear();
---

<footer class="footer" data-page-path={Astro.url.pathname}>
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link">Features</a></li>
      <li><a href="/pricing" class="footer-link">Pricing</a></li>
      <li><a href="/about" class="footer-link">About</a></li>
      <li><a href="/docs" class="footer-link">Docs</a></li>
      <li><a href="#" class="footer-link">Privacy</a></li>
      <li><a href="#" class="footer-link">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.querySelector('.footer');
    const footerLinks = document.querySelectorAll('.footer-link');

    footerLinks.forEach((link) => {
      link.addEventListener('click', () => {
        window.posthog?.capture('footer_link_clicked', {
          location: 'footer',
          page_path: footer?.getAttribute('data-page-path') || window.location.pathname,
          link_text: link.textContent?.trim() || 'unknown',
          destination: link.getAttribute('href') || '#',
        });
      });
    });
  });
</script>
