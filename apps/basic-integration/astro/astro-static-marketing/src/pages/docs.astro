---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Documentation" description="Learn how to get started with NeuralFlow AI.">
  <div class="page-header">
    <div class="container">
      <h1>Documentation</h1>
      <p>Everything you need to get started with NeuralFlow</p>
    </div>
  </div>

  <section class="features" style="padding-top: 3rem;">
    <div class="container">
      <div class="features-grid">
        <a href="#" class="feature-card" data-documentation-topic="getting_started" style="text-decoration: none;">
          <div class="feature-icon">🚀</div>
          <h3>Getting Started</h3>
          <p>Set up your account and start using NeuralFlow in under 5 minutes.</p>
        </a>
        <a href="#" class="feature-card" data-documentation-topic="api_reference" style="text-decoration: none;">
          <div class="feature-icon">📚</div>
          <h3>API Reference</h3>
          <p>Complete API documentation with examples for all endpoints.</p>
        </a>
        <a href="#" class="feature-card" data-documentation-topic="integrations" style="text-decoration: none;">
          <div class="feature-icon">🔌</div>
          <h3>Integrations</h3>
          <p>Connect NeuralFlow with your favorite tools and services.</p>
        </a>
        <a href="#" class="feature-card" data-documentation-topic="workflows" style="text-decoration: none;">
          <div class="feature-icon">🔄</div>
          <h3>Workflows</h3>
          <p>Build powerful automation workflows with our visual builder.</p>
        </a>
        <a href="#" class="feature-card" data-documentation-topic="security" style="text-decoration: none;">
          <div class="feature-icon">🔐</div>
          <h3>Security</h3>
          <p>Learn about our security practices and compliance certifications.</p>
        </a>
        <a href="#" class="feature-card" data-documentation-topic="faq" style="text-decoration: none;">
          <div class="feature-icon">❓</div>
          <h3>FAQ</h3>
          <p>Answers to commonly asked questions about NeuralFlow.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.querySelectorAll('[data-documentation-topic]').forEach((topic) => {
    topic.addEventListener('click', () => {
      window.posthog?.capture('documentation_topic_clicked', {
        topic: topic.dataset.documentationTopic,
      });
    });
  });
</script>
