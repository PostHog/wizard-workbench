---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about NeuralFlow and our mission to make AI accessible for everyone.">
  <div class="page-header">
    <div class="container">
      <h1>About NeuralFlow</h1>
      <p>We're on a mission to make AI-powered automation accessible to every team.</p>
    </div>
  </div>

  <section class="about-content">
    <div class="container">
      <p style="font-size: 1.25rem; color: var(--color-text-muted); max-width: 800px; margin: 0 auto; text-align: center;">
        Founded in 2023, NeuralFlow started with a simple idea: AI should make work easier, not harder.
        We've built a platform that brings the power of modern AI to everyday workflows,
        helping teams focus on what matters most.
      </p>

      <div class="about-grid">
        <div class="about-card">
          <h3>10K+</h3>
          <p>Active Users</p>
        </div>
        <div class="about-card">
          <h3>500M+</h3>
          <p>Documents Processed</p>
        </div>
        <div class="about-card">
          <h3>99.9%</h3>
          <p>Uptime SLA</p>
        </div>
        <div class="about-card">
          <h3>50+</h3>
          <p>Countries</p>
        </div>
      </div>
    </div>
  </section>

  <section class="team-section" style="background: var(--color-bg-secondary); padding: 4rem 0;">
    <div class="container">
      <div class="section-header">
        <h2>Meet the Team</h2>
        <p>The people building the future of work</p>
      </div>
      <div class="team-grid">
        <button class="team-member" type="button" data-team-member-role="ceo_cofounder" data-team-member-position="1" style="text-align: left;">
          <div class="team-avatar">👩‍💻</div>
          <h4>Sarah Chen</h4>
          <p>CEO & Co-founder</p>
        </button>
        <button class="team-member" type="button" data-team-member-role="cto_cofounder" data-team-member-position="2" style="text-align: left;">
          <div class="team-avatar">👨‍💻</div>
          <h4>Marcus Johnson</h4>
          <p>CTO & Co-founder</p>
        </button>
        <button class="team-member" type="button" data-team-member-role="head_of_ai_research" data-team-member-position="3" style="text-align: left;">
          <div class="team-avatar">👩‍🔬</div>
          <h4>Dr. Emily Park</h4>
          <p>Head of AI Research</p>
        </button>
        <button class="team-member" type="button" data-team-member-role="head_of_design" data-team-member-position="4" style="text-align: left;">
          <div class="team-avatar">👨‍🎨</div>
          <h4>Alex Rivera</h4>
          <p>Head of Design</p>
        </button>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const teamMembers = document.querySelectorAll('[data-team-member-role]');

    teamMembers.forEach((member) => {
      member.addEventListener('click', () => {
        window.posthog?.capture('team_member_selected', {
          team_member_role: member.getAttribute('data-team-member-role') || 'unknown',
          member_position: Number(member.getAttribute('data-team-member-position') || '0'),
          page_path: window.location.pathname,
        });
      });
    });
  });
</script>
