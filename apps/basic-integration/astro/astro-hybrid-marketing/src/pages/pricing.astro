---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing" description="Simple, transparent pricing for teams of all sizes.">
  <div class="page-header">
    <div class="container">
      <h1>Pricing</h1>
      <p>Simple, transparent pricing. No hidden fees.</p>
    </div>
  </div>

  <section class="pricing">
    <div class="container">
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Starter</h3>
          <div class="price">$29<span>/month</span></div>
          <p class="description">Perfect for individuals and small teams getting started.</p>
          <ul class="pricing-features">
            <li>Up to 5 team members</li>
            <li>1,000 AI requests/month</li>
            <li>10GB storage</li>
            <li>Basic integrations</li>
            <li>Email support</li>
          </ul>
          <a href="/contact" class="btn btn-secondary" style="width: 100%; justify-content: center;" data-posthog-event="pricing_cta_clicked" data-plan="starter" data-cta-type="get_started">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <h3>Pro</h3>
          <div class="price">$99<span>/month</span></div>
          <p class="description">For growing teams that need more power and flexibility.</p>
          <ul class="pricing-features">
            <li>Up to 25 team members</li>
            <li>10,000 AI requests/month</li>
            <li>100GB storage</li>
            <li>All integrations</li>
            <li>Priority support</li>
            <li>Advanced analytics</li>
            <li>Custom workflows</li>
          </ul>
          <a href="/contact" class="btn btn-primary" style="width: 100%; justify-content: center;" data-posthog-event="pricing_cta_clicked" data-plan="pro" data-cta-type="start_free_trial">Start Free Trial</a>
        </div>

        <div class="pricing-card">
          <h3>Enterprise</h3>
          <div class="price">Custom</div>
          <p class="description">For large organizations with custom requirements.</p>
          <ul class="pricing-features">
            <li>Unlimited team members</li>
            <li>Unlimited AI requests</li>
            <li>Unlimited storage</li>
            <li>Custom integrations</li>
            <li>Dedicated support</li>
            <li>SLA guarantees</li>
            <li>On-premise deployment</li>
            <li>Custom training</li>
          </ul>
          <a href="/contact" class="btn btn-secondary" style="width: 100%; justify-content: center;" data-posthog-event="contact_sales_clicked" data-plan="enterprise">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const pricingCta = target.closest('[data-posthog-event="pricing_cta_clicked"]');
    if (pricingCta instanceof HTMLAnchorElement) {
      window.posthog?.capture('pricing_cta_clicked', {
        plan: pricingCta.dataset.plan || 'unknown',
        cta_type: pricingCta.dataset.ctaType || 'unknown',
        destination: pricingCta.getAttribute('href') || '',
        current_path: window.location.pathname,
      });
      return;
    }

    const contactSales = target.closest('[data-posthog-event="contact_sales_clicked"]');
    if (contactSales instanceof HTMLAnchorElement) {
      window.posthog?.capture('contact_sales_clicked', {
        plan: contactSales.dataset.plan || 'unknown',
        destination: contactSales.getAttribute('href') || '',
        current_path: window.location.pathname,
      });
    }
  });
</script>
