---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/contact" class:list={["nav-link", { active: currentPath === '/contact' }]}>Contact</a></li>
      <li><a href="#" class="nav-cta" data-posthog-event="get_started_cta_clicked">Get Started</a></li>
    </ul>
  </div>
</nav>

<script>
  document.querySelector<HTMLElement>('[data-posthog-event]')?.addEventListener('click', (event) => {
    const cta = event.currentTarget as HTMLElement;
    window.posthog?.capture(cta.dataset.posthogEvent as string);
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
