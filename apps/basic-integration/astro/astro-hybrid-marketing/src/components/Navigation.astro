---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/contact" class:list={["nav-link", { active: currentPath === '/contact' }]}>Contact</a></li>
      <li><a href="/pricing" class="nav-cta" data-posthog-event="navigation_cta_clicked">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const cta = target.closest('[data-posthog-event="navigation_cta_clicked"]');
    if (!cta) return;

    window.posthog?.capture('navigation_cta_clicked', {
      location: 'navigation',
      destination: '/pricing',
      current_path: window.location.pathname,
    });
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
