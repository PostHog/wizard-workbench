---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/contact" class:list={["nav-link", { active: currentPath === '/contact' }]}>Contact</a></li>
      <li><a href="#" class="nav-cta" id="nav-get-started-btn">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.getElementById('nav-get-started-btn')?.addEventListener('click', function () {
    window.posthog?.capture('get_started_clicked', { source: 'navigation' });
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
