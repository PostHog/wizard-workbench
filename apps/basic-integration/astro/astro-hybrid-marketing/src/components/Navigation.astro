---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/contact" class:list={["nav-link", { active: currentPath === '/contact' }]}>Contact</a></li>
      <li><a href="#" class="nav-cta" data-posthog-event="navigation_cta_clicked" data-cta-location="navigation" data-cta-target="get_started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const cta = document.querySelector('[data-posthog-event="navigation_cta_clicked"]');

    cta?.addEventListener('click', () => {
      window.posthog?.capture('navigation_cta_clicked', {
        cta_location: cta.getAttribute('data-cta-location') || 'navigation',
        cta_target: cta.getAttribute('data-cta-target') || 'get_started',
        current_path: window.location.pathname
      });
    });
  });
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
