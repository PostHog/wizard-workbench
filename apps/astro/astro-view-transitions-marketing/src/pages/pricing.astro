---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing" description="Simple, transparent pricing for teams of all sizes.">
  <div class="page-header">
    <div class="container">
      <h1>Pricing</h1>
      <p>Simple, transparent pricing. No hidden fees.</p>
    </div>
  </div>

  <section class="pricing">
    <div class="container">
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Starter</h3>
          <div class="price">$29<span>/month</span></div>
          <p class="description">Perfect for individuals and small teams getting started.</p>
          <ul class="pricing-features">
            <li>Up to 5 team members</li>
            <li>1,000 AI requests/month</li>
            <li>10GB storage</li>
            <li>Basic integrations</li>
            <li>Email support</li>
          </ul>
          <a href="#" class="btn btn-secondary pricing-plan-cta" data-plan="Starter" data-price="29" style="width: 100%; justify-content: center;">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <h3>Pro</h3>
          <div class="price">$99<span>/month</span></div>
          <p class="description">For growing teams that need more power and flexibility.</p>
          <ul class="pricing-features">
            <li>Up to 25 team members</li>
            <li>10,000 AI requests/month</li>
            <li>100GB storage</li>
            <li>All integrations</li>
            <li>Priority support</li>
            <li>Advanced analytics</li>
            <li>Custom workflows</li>
          </ul>
          <a href="#" class="btn btn-primary pricing-plan-cta" data-plan="Pro" data-price="99" style="width: 100%; justify-content: center;">Start Free Trial</a>
        </div>

        <div class="pricing-card">
          <h3>Enterprise</h3>
          <div class="price">Custom</div>
          <p class="description">For large organizations with custom requirements.</p>
          <ul class="pricing-features">
            <li>Unlimited team members</li>
            <li>Unlimited AI requests</li>
            <li>Unlimited storage</li>
            <li>Custom integrations</li>
            <li>Dedicated support</li>
            <li>SLA guarantees</li>
            <li>On-premise deployment</li>
            <li>Custom training</li>
          </ul>
          <a href="#" class="btn btn-secondary" id="contact-sales-cta" style="width: 100%; justify-content: center;">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function setupPricingPage() {
    // Track pricing page view (top of conversion funnel)
    window.posthog?.capture('pricing_page_viewed');

    // Pricing plan CTAs (Starter, Pro)
    document.querySelectorAll('.pricing-plan-cta').forEach(function(btn) {
      btn.removeEventListener('click', handlePlanCta);
      btn.addEventListener('click', handlePlanCta);
    });

    // Enterprise contact sales CTA
    const contactSalesBtn = document.getElementById('contact-sales-cta');
    contactSalesBtn?.removeEventListener('click', handleContactSales);
    contactSalesBtn?.addEventListener('click', handleContactSales);
  }

  function handlePlanCta(event) {
    var btn = event.currentTarget;
    window.posthog?.capture('pricing_plan_cta_clicked', {
      plan: btn.dataset.plan,
      price_per_month: btn.dataset.price ? parseInt(btn.dataset.price, 10) : null,
      label: btn.textContent.trim()
    });
  }

  function handleContactSales() {
    window.posthog?.capture('contact_sales_clicked', {
      plan: 'Enterprise',
      location: 'pricing'
    });
  }

  document.addEventListener('DOMContentLoaded', setupPricingPage);
  document.addEventListener('astro:page-load', setupPricingPage);
</script>
