---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link">Features</a></li>
      <li><a href="/pricing" class="footer-link">Pricing</a></li>
      <li><a href="/about" class="footer-link">About</a></li>
      <li><a href="/docs" class="footer-link">Docs</a></li>
      <li><a href="#" class="footer-link">Privacy</a></li>
      <li><a href="#" class="footer-link">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  function handleFooterLinkClick(event) {
    const link = event.currentTarget;
    window.posthog?.capture('footer_link_clicked', {
      link_text: link.textContent?.trim(),
      link_href: link.getAttribute('href')
    });
  }

  function setupFooterTracking() {
    const footerLinks = document.querySelectorAll('.footer-link');
    footerLinks.forEach(function(link) {
      link.removeEventListener('click', handleFooterLinkClick);
      link.addEventListener('click', handleFooterLinkClick);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooterTracking);
  document.addEventListener('astro:page-load', setupFooterTracking);
</script>
