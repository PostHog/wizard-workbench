---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" id="nav-get-started">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  function setupNavEvents() {
    var navGetStarted = document.getElementById('nav-get-started');
    navGetStarted?.removeEventListener('click', navGetStarted._phHandler);
    navGetStarted._phHandler = function() {
      window.posthog?.capture('nav_get_started_clicked', { location: 'navigation' });
    };
    navGetStarted?.addEventListener('click', navGetStarted._phHandler);
  }

  document.addEventListener('DOMContentLoaded', setupNavEvents);
  document.addEventListener('astro:page-load', setupNavEvents);
</script>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>
