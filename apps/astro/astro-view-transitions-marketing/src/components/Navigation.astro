---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> AI
    </a>
    <ul class="nav-links">
      <li><a href="/features" class:list={["nav-link", { active: currentPath === '/features' }]}>Features</a></li>
      <li><a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' }]}>Pricing</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a></li>
      <li><a href="/docs" class:list={["nav-link", { active: currentPath === '/docs' }]}>Docs</a></li>
      <li><a href="#" class="nav-cta" id="nav-get-started">Get Started</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav-link.active {
    color: var(--color-text);
  }
</style>

<script is:inline>
  function setupNavigation() {
    const navCtaBtn = document.getElementById('nav-get-started');

    function handleNavCtaClick() {
      window.posthog?.capture('nav_cta_clicked', {
        location: 'navigation'
      });
    }

    // Remove existing listener to prevent duplicates during view transitions
    navCtaBtn?.removeEventListener('click', handleNavCtaClick);
    navCtaBtn?.addEventListener('click', handleNavCtaClick);
  }

  // Run on initial page load
  document.addEventListener('DOMContentLoaded', setupNavigation);

  // Run after view transitions complete (for soft navigation)
  document.addEventListener('astro:page-load', setupNavigation);
</script>
