---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href="/features" class="footer-link" data-footer-dest="features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-footer-dest="pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-footer-dest="about">About</a></li>
      <li><a href="/docs" class="footer-link" data-footer-dest="docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-footer-dest="privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-footer-dest="terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-footer-dest]').forEach(function (link) {
      link.addEventListener('click', function () {
        var dest = link.getAttribute('data-footer-dest');
        window.posthog?.capture('footer_link_clicked', {
          destination: dest
        });
      });
    });
  });
</script>
