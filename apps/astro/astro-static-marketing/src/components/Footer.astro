---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links" id="footer-links">
      <li><a href="/features" class="footer-link" data-footer-link="features">Features</a></li>
      <li><a href="/pricing" class="footer-link" data-footer-link="pricing">Pricing</a></li>
      <li><a href="/about" class="footer-link" data-footer-link="about">About</a></li>
      <li><a href="/docs" class="footer-link" data-footer-link="docs">Docs</a></li>
      <li><a href="#" class="footer-link" data-footer-link="privacy">Privacy</a></li>
      <li><a href="#" class="footer-link" data-footer-link="terms">Terms</a></li>
    </ul>
    <p class="footer-copy">&copy; {currentYear} NeuralFlow AI. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-footer-link]').forEach(function (link) {
      link.addEventListener('click', function () {
        var label = link.getAttribute('data-footer-link');
        window.posthog?.capture('footer_link_clicked', { link: label });
      });
    });
  });
</script>
