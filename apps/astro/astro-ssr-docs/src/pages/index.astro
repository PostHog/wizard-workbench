---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1><span>NeuralFlow</span> Documentation</h1>
      <p class="hero-description">
        Learn how to integrate AI-powered automation into your applications.
        Comprehensive guides, API references, and best practices.
      </p>
      <div class="hero-buttons">
        <a href="/docs" class="btn btn-primary" id="hero-get-started">Get Started</a>
        <a href="/docs/api" class="btn btn-secondary" id="hero-api-reference">API Reference</a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <a href="/docs" class="feature-card" data-card-title="Quick Start Guide">
          <h3>Quick Start Guide</h3>
          <p>Get up and running with NeuralFlow in under 5 minutes.</p>
        </a>
        <a href="/docs/concepts" class="feature-card" data-card-title="Core Concepts">
          <h3>Core Concepts</h3>
          <p>Understand the fundamentals of AI-powered automation.</p>
        </a>
        <a href="/docs/workflows" class="feature-card" data-card-title="Workflow Builder">
          <h3>Workflow Builder</h3>
          <p>Create complex automation sequences visually.</p>
        </a>
        <a href="/docs/api" class="feature-card" data-card-title="API Reference">
          <h3>API Reference</h3>
          <p>Complete documentation for all API endpoints.</p>
        </a>
        <a href="/docs/api/authentication" class="feature-card" data-card-title="Authentication">
          <h3>Authentication</h3>
          <p>Secure your integrations with API keys and OAuth.</p>
        </a>
        <a href="/docs/api/endpoints" class="feature-card" data-card-title="REST Endpoints">
          <h3>REST Endpoints</h3>
          <p>Explore all available API endpoints and methods.</p>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p class="footer-copy">&copy; 2024 NeuralFlow AI. All rights reserved.</p>
    </div>
  </footer>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('hero-get-started')?.addEventListener('click', function () {
      window.posthog?.capture('get_started_clicked', {
        location: 'hero'
      });
    });

    document.getElementById('hero-api-reference')?.addEventListener('click', function () {
      window.posthog?.capture('api_reference_clicked', {
        location: 'hero'
      });
    });

    document.querySelectorAll('.feature-card').forEach(function (card) {
      card.addEventListener('click', function (e) {
        var title = e.currentTarget.getAttribute('data-card-title');
        var href = e.currentTarget.getAttribute('href');
        window.posthog?.capture('feature_card_clicked', {
          card_title: title,
          href: href
        });
      });
    });
  });
</script>
