---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link github-link" target="_blank">GitHub</a></li>
      <li><a href="#" class="nav-cta nav-cta-btn">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelector('.github-link')?.addEventListener('click', function () {
      window.posthog?.capture('github_link_clicked', { location: 'navigation' });
    });

    document.querySelector('.nav-cta-btn')?.addEventListener('click', function () {
      window.posthog?.capture('nav_cta_clicked', { location: 'navigation' });
    });
  });
</script>
