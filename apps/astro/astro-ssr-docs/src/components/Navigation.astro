---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link nav-external" target="_blank" data-external-name="GitHub">GitHub</a></li>
      <li><a href="#" class="nav-cta" id="nav-cta-btn">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Track nav CTA click
    document.getElementById('nav-cta-btn')?.addEventListener('click', () => {
      window.posthog?.capture('nav_cta_clicked', {
        button_text: 'Get Started',
        location: 'navigation'
      });
    });

    // Track external link clicks
    document.querySelectorAll('.nav-external').forEach((link) => {
      link.addEventListener('click', () => {
        const linkName = link.getAttribute('data-external-name');
        window.posthog?.capture('external_link_clicked', {
          link_name: linkName,
          destination: link.getAttribute('href'),
          location: 'navigation'
        });
      });
    });
  });
</script>
