---
const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith('/docs');
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span>NeuralFlow</span> Docs
    </a>
    <ul class="nav-links">
      <li><a href="/docs" class:list={["nav-link", { active: isDocs }]}>Documentation</a></li>
      <li><a href="/docs/api" class="nav-link">API Reference</a></li>
      <li><a href="https://github.com" class="nav-link" target="_blank">GitHub</a></li>
      <li><a href="#" class="nav-cta">Get Started</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Track external link clicks in navigation
    const navLinks = document.querySelectorAll('.nav-links a');
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const href = target.getAttribute('href');
        const text = target.textContent?.trim();
        const isExternal = target.getAttribute('target') === '_blank' || (href && href.startsWith('http'));

        if (isExternal) {
          window.posthog?.capture('external_link_clicked', {
            link_text: text,
            destination_url: href,
            location: 'navigation'
          });
        }
      });
    });
  });
</script>
