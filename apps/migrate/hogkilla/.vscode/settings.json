{
  "files.associations": {
    "**/.env**": "properties"
  },
  "editor.tabSize": 2,
  "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "[javascript]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true
}
