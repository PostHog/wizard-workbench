# Repository paths (use ~ for home directory, or absolute paths)
CONTEXT_MILL_PATH=~/development/context-mill
# Points evaluator at context-mill's commandments directly (zero drift). Falls back to vendored copy if unset.
COMMANDMENTS_PATH=~/development/context-mill/context/commandments.yaml
MCP_PATH=~/development/posthog/services/mcp
WIZARD_PATH=~/development/wizard

# PostHog credentials - used for Wizard CI mode (the PostHog API and MCP)
POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_REGION is optional, defaults to 'us'. Can also be passed via --region flag or workflow input.
# POSTHOG_REGION=us
POSTHOG_WIZARD_PROJECT_ID=123

# AI gateway key for model calls: a phs_ project secret key with the llm_gateway:read scope.
# With `op run --env-file .env -- pnpm wizard-ci ...` this can be an op:// reference instead of the key.
POSTHOG_GATEWAY_TOKEN=phs_...
